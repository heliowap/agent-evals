              "command": "python3 - <<'PY'\nimport csv\nimport json\nfrom collections import Counter\nfrom pathlib import Path\n\nwith Path('batch-a.csv').open(newline='', encoding='utf-8') as source:\n    reader = csv.DictReader(source)\n    if not {'region', 'state'}.issubset(reader.fieldnames or []):\n        raise ValueError('CSV must contain region and state columns')\n    counts = Counter(row['region'] for row in reader if row['state'] == 'ready')\n\nsummary = dict(sorted(counts.items()))\noutput = Path('a-summary.json')\nwith output.open('x', encoding='utf-8') as target:\n    json.dump(summary, target, indent=2)\n    target.write('\\n')\nassert json.loads(output.read_text(encoding='utf-8')) == summary\nprint(output.read_text(encoding='utf-8'), end='')\nPY"
