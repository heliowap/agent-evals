                  "patch": "Index: /tmp/folders/<tmpdir-id>/T/detfirst-opencode-1av08o12/trial-0004/tmp/opencode/summarize_ready.py\n===================================================================\n--- /tmp/folders/<tmpdir-id>/T/detfirst-opencode-1av08o12/trial-0004/tmp/opencode/summarize_ready.py\n+++ /tmp/folders/<tmpdir-id>/T/detfirst-opencode-1av08o12/trial-0004/tmp/opencode/summarize_ready.py\n@@ -0,0 +1,28 @@\n+import csv\n+import json\n+import sys\n+from collections import Counter\n+from io import StringIO\n+from pathlib import Path\n+\n+\n+def count_ready(source):\n+    reader = csv.DictReader(source)\n+    if not {'region', 'state'}.issubset(reader.fieldnames or []):\n+        raise ValueError('CSV must contain region and state columns')\n+    counts = Counter(row['region'] for row in reader if row['state'] == 'ready')\n+    return dict(sorted(counts.items()))\n+\n+\n+if __name__ == '__main__':\n+    sample = StringIO('region,state\\nN,ready\\nS,blocked\\nN,ready\\nS,ready\\n')\n+    assert count_ready(sample) == {'N': 2, 'S': 1}\n+\n+    source_path, output_path = map(Path, sys.argv[1:])\n+    with source_path.open(newline='', encoding='utf-8') as source:\n+        summary = count_ready(source)\n+    with output_path.open('x', encoding='utf-8') as target:\n+        json.dump(summary, target, indent=2)\n+        target.write('\\n')\n+    assert json.loads(output_path.read_text(encoding='utf-8')) == summary\n+    print(f'{output_path}: {json.dumps(summary)}')\n",
