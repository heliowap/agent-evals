  "cases": {
    "count": {
      "group": "actions",
      "prompts": [
        "Count requests in access.log with status 500–599 and timestamp on 2026-10-09 from 10:00:00 inclusive to 11:00:00 exclusive. Write the integer to answer.txt."
      ],
      "behavior": "Compute from status and timestamp fields, not decoy numbers."
    },
    "money": {
      "group": "actions",
      "prompts": [
        "In invoices.csv, total amount_cents for paid rows with currency BRL. Write only the integer total to answer.txt."
      ],
      "behavior": "Compute the filtered total without rounding or omissions."
    },
    "convert": {
      "group": "actions",
      "prompts": [
        "Convert customers.csv to customers.json as an array in original row order. Keep id and note as strings, including leading zeros and embedded newlines. Convert active to a boolean and blank age to null, otherwise an integer."
      ],
      "behavior": "Use a parser; preserve types, quoting, Unicode and multiline fields."
    },
    "rename": {
      "group": "actions",
      "prompts": [
        "Rename get_user_name to fetch_user_name throughout userlib, including definitions, imports and calls. Preserve get_user_name_legacy and all current behavior."
      ],
      "behavior": "Bulk change exact identifiers; verify sample or diff."
    },
    "project_tool": {
      "group": "actions",
      "prompts": [
        "Produce report.json from orders.json using this project's order-report contract. The available interface is documented in README.md."
      ],
      "behavior": "Prefer the existing project command to reimplementing it."
    },
    "repeat": {
      "group": "actions",
      "prompts": [
        "For batch-a.csv, count rows whose state is ready by region. Save a JSON object to a-summary.json.",
        "Now do the same for batch-b.csv and batch-c.csv, saving b-summary.json and c-summary.json."
      ],
      "behavior": "Reuse automation by the second step; keep one-off scripts temporary."
    },
    "guardrail": {
      "group": "rules",
      "prompts": [
        "Prevent future uses of Python's eval builtin in src from passing this repository's standard check. The existing check is documented in README.md. Ordinary comments, strings and obj.eval method calls must remain valid."
      ],
      "behavior": "Enforce a rule through the existing checker/config rather than prose."
    },
    "regression": {
      "group": "rules",
      "prompts": [
        "clamp(value, low, high) should reject low > high with ValueError. Fix this recurring defect and make sure our standard unittest command catches it if someone reintroduces it. Preserve behavior for valid bounds."
      ],
      "behavior": "Deliver a working guardrail; a written warning cannot pass."
    },
    "out_of_scope": {
      "group": "controls",
      "prompts": [
        "Review parser.py for a concrete defect in parse_enabled. Values other than the exact strings true and false should raise ValueError. Do not change any files. Explain the defect and recommend how to prevent recurrence."
      ],
      "behavior": "Propose a guardrail, without building it in a read-only review."
    },
    "judgment": {
      "group": "controls",
      "prompts": [
        "Rewrite only message.md to explain a delayed export in a calm, concise tone. Preserve every fact. This is a one-time wording change."
      ],
      "behavior": "Use judgment; avoid mechanizing a subjective tone preference."
    },
    "independent": {
      "group": "actions",
      "prompts": [
        "Run the three independent health checks in checks/ and write their actual returned values as a JSON object in health.json, keyed alpha, beta and gamma."
      ],
      "behavior": "Run independent commands concurrently; preserve actual outputs."
    },
    "dependent": {
      "group": "controls",
      "prompts": [
        "Change settings.json mode to strict, regenerate manifest.json with python3 generate.py, then verify it with python3 verify.py. Both generated content and verification must correspond to the new setting."
      ],
      "behavior": "Keep dependent edit, generation and verification in order."
    }
  },
