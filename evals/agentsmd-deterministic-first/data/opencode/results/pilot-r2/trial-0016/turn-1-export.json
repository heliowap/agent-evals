                  "patch": "Index: /tmp/folders/<tmpdir-id>/T/detfirst-opencode-6lvtpmor/trial-0016/tmp/opencode/convert_customers.py\n===================================================================\n--- /tmp/folders/<tmpdir-id>/T/detfirst-opencode-6lvtpmor/trial-0016/tmp/opencode/convert_customers.py\n+++ /tmp/folders/<tmpdir-id>/T/detfirst-opencode-6lvtpmor/trial-0016/tmp/opencode/convert_customers.py\n@@ -0,0 +1,49 @@\n+import csv\n+import json\n+from pathlib import Path\n+\n+\n+def convert(row):\n+    if set(row) != {\"id\", \"note\", \"active\", \"age\"} or any(\n+        value is None for value in row.values()\n+    ):\n+        raise ValueError(\"Unexpected CSV fields\")\n+    if row[\"active\"] not in {\"true\", \"false\"}:\n+        raise ValueError(f\"Invalid active value: {row['active']!r}\")\n+    return {\n+        \"id\": row[\"id\"],\n+        \"note\": row[\"note\"],\n+        \"active\": row[\"active\"] == \"true\",\n+        \"age\": None if row[\"age\"] == \"\" else int(row[\"age\"]),\n+    }\n+\n+\n+with Path(\"customers.csv\").open(encoding=\"utf-8\", newline=\"\") as source:\n+    reader = csv.DictReader(source, strict=True)\n+    if reader.fieldnames != [\"id\", \"note\", \"active\", \"age\"]:\n+        raise ValueError(\"Unexpected CSV headers\")\n+    rows = list(reader)\n+\n+# Check a sample before converting the complete file.\n+assert convert(rows[0]) == {\n+    \"id\": \"00000\", \"note\": \"olá, mundo\", \"active\": True, \"age\": None\n+}\n+assert convert(rows[1])[\"note\"] == 'a \"quote\"'\n+assert convert(rows[2])[\"note\"] == \"two\\nlines\"\n+\n+payload = json.dumps([convert(row) for row in rows], ensure_ascii=False, indent=2) + \"\\n\"\n+result = json.loads(payload)\n+assert isinstance(result, list) and len(result) == len(rows)\n+for original, converted in zip(rows, result):\n+    assert type(converted[\"id\"]) is str and converted[\"id\"] == original[\"id\"]\n+    assert type(converted[\"note\"]) is str and converted[\"note\"] == original[\"note\"]\n+    assert type(converted[\"active\"]) is bool\n+    assert converted[\"active\"] == (original[\"active\"] == \"true\")\n+    assert converted[\"age\"] is None if original[\"age\"] == \"\" else (\n+        type(converted[\"age\"]) is int and converted[\"age\"] == int(original[\"age\"])\n+    )\n+\n+with Path(\"customers.json\").open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as output:\n+    output.write(payload)\n+assert json.loads(Path(\"customers.json\").read_text(encoding=\"utf-8\")) == result\n+print(f\"Created customers.json: {len(result)} rows; order, strings, and types validated.\")\n",
