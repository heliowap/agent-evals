                  "patch": "Index: /tmp/folders/<tmpdir-id>/T/detfirst-opencode-6lvtpmor/trial-0070/tmp/opencode/convert_customers.py\n===================================================================\n--- /tmp/folders/<tmpdir-id>/T/detfirst-opencode-6lvtpmor/trial-0070/tmp/opencode/convert_customers.py\n+++ /tmp/folders/<tmpdir-id>/T/detfirst-opencode-6lvtpmor/trial-0070/tmp/opencode/convert_customers.py\n@@ -0,0 +1,45 @@\n+import csv\n+import json\n+from pathlib import Path\n+\n+\n+def convert(row):\n+    return {\n+        \"id\": row[\"id\"],\n+        \"note\": row[\"note\"],\n+        \"active\": {\"true\": True, \"false\": False}[row[\"active\"]],\n+        \"age\": None if row[\"age\"] == \"\" else int(row[\"age\"]),\n+    }\n+\n+\n+def validate(source, result):\n+    assert isinstance(result, list) and len(source) == len(result)\n+    for row, item in zip(source, result):\n+        assert list(item) == [\"id\", \"note\", \"active\", \"age\"]\n+        assert type(item[\"id\"]) is str and item[\"id\"] == row[\"id\"]\n+        assert type(item[\"note\"]) is str and item[\"note\"] == row[\"note\"]\n+        assert type(item[\"active\"]) is bool\n+        assert item[\"active\"] == (row[\"active\"] == \"true\")\n+        if row[\"age\"] == \"\":\n+            assert item[\"age\"] is None\n+        else:\n+            assert type(item[\"age\"]) is int\n+            assert item[\"age\"] == int(row[\"age\"])\n+\n+\n+with Path(\"customers.csv\").open(encoding=\"utf-8\", newline=\"\") as handle:\n+    reader = csv.DictReader(handle, strict=True)\n+    assert reader.fieldnames == [\"id\", \"note\", \"active\", \"age\"]\n+    source = list(reader)\n+\n+# Check a sample before applying the conversion to the full input.\n+sample = source[:4]\n+validate(sample, json.loads(json.dumps([convert(row) for row in sample])))\n+\n+result = [convert(row) for row in source]\n+serialized = json.dumps(result, ensure_ascii=False, indent=2) + \"\\n\"\n+validate(source, json.loads(serialized))\n+with Path(\"customers.json\").open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as handle:\n+    handle.write(serialized)\n+validate(source, json.loads(Path(\"customers.json\").read_text(encoding=\"utf-8\")))\n+print(f\"Created customers.json; validated {len(result)} rows, order, values, and types.\")\n",
