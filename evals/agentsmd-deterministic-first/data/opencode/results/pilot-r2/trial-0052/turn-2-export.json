              "patchText": "*** Begin Patch\n*** Add File: /tmp/folders/<tmpdir-id>/T/detfirst-opencode-6lvtpmor/trial-0052/tmp/opencode/count-ready-by-region.py\n+import csv\n+import json\n+import sys\n+from collections import Counter\n+\n+\n+def count_ready(rows):\n+    return dict(sorted(Counter(row['region'] for row in rows if row['state'] == 'ready').items()))\n+\n+\n+assert count_ready([\n+    {'region': 'N', 'state': 'ready'},\n+    {'region': 'N', 'state': 'ready'},\n+    {'region': 'S', 'state': 'blocked'},\n+    {'region': 'S', 'state': 'ready'},\n+]) == {'N': 2, 'S': 1}\n+\n+arguments = sys.argv[1:]\n+if not arguments or len(arguments) % 2:\n+    raise SystemExit('Usage: count-ready-by-region.py INPUT OUTPUT [INPUT OUTPUT ...]')\n+\n+for source_name, destination_name in zip(arguments[::2], arguments[1::2]):\n+    with open(source_name, newline='', encoding='utf-8') as source:\n+        rows = csv.DictReader(source)\n+        if not {'region', 'state'}.issubset(rows.fieldnames or []):\n+            raise ValueError(f'{source_name}: missing region or state column')\n+        summary = count_ready(rows)\n+    with open(destination_name, 'x', encoding='utf-8') as destination:\n+        json.dump(summary, destination, indent=2)\n+        destination.write('\\n')\n+    print(f'{destination_name}: {json.dumps(summary, sort_keys=True)}')\n*** End Patch"
            },
