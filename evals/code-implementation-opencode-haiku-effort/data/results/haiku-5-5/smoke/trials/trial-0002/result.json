          "command": "cd /workspace && cat > src/numbers.py <<'EOF'\ndef add(left, right):\n    return left + right\n\n\ndef clamp(value, lower, upper):\n    \"\"\"Return value limited to the inclusive range [lower, upper].\n\n    Returns lower if value < lower, upper if value > upper, otherwise value.\n    Raises ValueError if lower > upper.\n    \"\"\"\n    if lower > upper:\n        raise ValueError(\"lower must be less than or equal to upper\")\n    if value < lower:\n        return lower\n    if value > upper:\n        return upper\n    return value\nEOF\ncat > checks/public.py <<'EOF'\nimport sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path.cwd()))\nfrom src.numbers import add, clamp\nimport pytest_free_guard if False else None\nEOF\ncat > checks/public.py <<'EOF'\nimport sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path.cwd()))\nfrom src.numbers import add, clamp\nassert add(2, 3) == 5\n\n# clamp: inside, below, above, and inclusive bounds\nassert clamp(5, 0, 10) == 5\nassert clamp(-1, 0, 10) == 0\nassert clamp(11, 0, 10) == 10\nassert clamp(0, 0, 10) == 0\nassert clamp(10, 0, 10) == 10\nassert clamp(3, 3, 3) == 3\n\n# lower > upper is rejected\ntry:\n    clamp(5, 10, 0)\nexcept ValueError:\n    pass\nelse:\n    raise AssertionError(\"expected ValueError for lower > upper\")\nEOF\npython3 checks/public.py && echo OK && cat src/numbers.py | head -3"
