        "checks/public.py": "import sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path.cwd()))\nfrom src.numbers import add, clamp\nassert add(2, 3) == 5\n\n# Inside the range: value is returned unchanged.\nassert clamp(5, 0, 10) == 5\n# Below the range: lower is returned.\nassert clamp(-3, 0, 10) == 0\n# Above the range: upper is returned.\nassert clamp(42, 0, 10) == 10\n# Bounds are inclusive.\nassert clamp(0, 0, 10) == 0\nassert clamp(10, 0, 10) == 10\n# lower == upper is allowed.\nassert clamp(7, 4, 4) == 4\nassert clamp(1, 4, 4) == 4\nassert clamp(9, 4, 4) == 4\n# Floats and mixed numeric types.\nassert clamp(2.5, 0, 10) == 2.5\nassert clamp(-0.5, 0.0, 1.0) == 0.0\nassert clamp(1.5, 0.0, 1.0) == 1.0\n# Negative ranges.\nassert clamp(-7, -10, -5) == -7\nassert clamp(-12, -10, -5) == -10\nassert clamp(-1, -10, -5) == -5\n# Returned value keeps its own type when inside the range.\nassert type(clamp(3, 0, 10)) is int\n# lower > upper must raise ValueError.\ntry:\n    clamp(5, 10, 0)\nexcept ValueError:\n    pass\nelse:\n    raise AssertionError(\"clamp(5, 10, 0) should raise ValueError\")\ntry:\n    clamp(5, 1, 0)\nexcept ValueError:\n    pass\nelse:\n    raise AssertionError(\"clamp(5, 1, 0) should raise ValueError\")\n",
        "src/numbers.py": "def add(left, right):\n    return left + right\n\n\ndef clamp(value, lower, upper):\n    \"\"\"Return ``value`` limited to the inclusive range [lower, upper].\n\n    Returns ``lower`` if ``value`` is below it, ``upper`` if ``value`` is\n    above it, and ``value`` otherwise. Raises ``ValueError`` if ``lower``\n    is greater than ``upper``.\n    \"\"\"\n    if lower > upper:\n        raise ValueError(f\"lower ({lower!r}) must not be greater than upper ({upper!r})\")\n    if value < lower:\n        return lower\n    if value > upper:\n        return upper\n    return value\n"
      },
