        "input": {
          "command": "cd /workspace && cat > src/repository.py <<'EOF'\ndef initialize(connection):\n    connection.execute(\"CREATE TABLE documents(id INTEGER PRIMARY KEY, tenant TEXT, owner TEXT, title TEXT, body TEXT, deleted_at TEXT)\")\n    connection.commit()\n\ndef decode(row):\n    return {\"id\": row[0], \"title\": row[1], \"body\": row[2]}\n\ndef find(connection, tenant, owner, document_id):\n    row = connection.execute(\n        \"SELECT id, title, body FROM documents WHERE id=? AND tenant=? AND owner=? AND deleted_at IS NULL\",\n        (document_id, tenant, owner),\n    ).fetchone()\n    return None if row is None else decode(row)\n\ndef listing(connection, tenant, owner):\n    return [\n        decode(row)\n        for row in connection.execute(\n            \"SELECT id, title, body FROM documents WHERE tenant=? AND owner=? AND deleted_at IS NULL ORDER BY id\",\n            (tenant, owner),\n        )\n    ]\nEOF\ncat > src/service.py <<'EOF'\nfrom .repository import find, listing\n\ndef get_document(connection, tenant, owner, document_id):\n    return find(connection, tenant, owner, document_id)\n\ndef list_documents(connection, tenant, owner):\n    return listing(connection, tenant, owner)\nEOF\nmkdir -p checks && cat > checks/access_scope.py <<'EOF'\nimport os, sys\nsys.path.insert(0, os.getcwd())\nimport sqlite3\nfrom src.repository import initialize\nfrom src.service import get_document, list_documents\n\nc = sqlite3.connect(\":memory:\")\ninitialize(c)\nrows = [\n    (1, \"t\", \"o\", \"A\", \"a\", None),\n    (2, \"t\", \"o\", \"B\", \"b\", \"2026-01-01\"),   # deleted\n    (3, \"other\", \"o\", \"C\", \"c\", None),       # other tenant\n    (4, \"t\", \"other\", \"D\", \"d\", None),       # other owner\n    (5, \"t\", \"o'x\", \"Q\", \"q\", None),         # quote in owner\n    (6, \"t\", \"o\", \"E\", \"e'\\\"\", None),        # quote in body\n    (7, \"t\", \"o\", \"F\", \"f\", None),\n]\nc.executemany(\"INSERT INTO documents VALUES (?, ?, ?, ?, ?, ?)\", rows)\nc.commit()\n\nassert get_document(c, \"t\", \"o\", 1) == {\"id\": 1, \"title\": \"A\", \"body\": \"a\"}\nassert get_document(c, \"t\", \"o\", 2) is None\nassert get_document(c, \"t\", \"o\", 3) is None\nassert get_document(c, \"t\", \"o\", 4) is None\nassert get_document(c, \"t\", \"o'x\", 5) == {\"id\": 5, \"title\": \"Q\", \"body\": \"q\"}\nassert get_document(c, \"t\", \"o\", 5) is None\nassert get_document(c, \"t\", \"o\", 6)[\"body\"] == \"e'\\\"\"\nassert get_document(c, \"t' OR '1'='1\", \"o\", 1) is None\nassert get_document(c, \"t\", \"o' OR '1'='1\", 1) is None\n\nassert list_documents(c, \"t\", \"o\") == [\n    {\"id\": 1, \"title\": \"A\", \"body\": \"a\"},\n    {\"id\": 6, \"title\": \"E\", \"body\": \"e'\\\"\"},\n    {\"id\": 7, \"title\": \"F\", \"body\": \"f\"},\n]\nassert list_documents(c, \"t\", \"o' OR '1'='1\") == []\nassert list_documents(c, \"other\", \"o\") == [{\"id\": 3, \"title\": \"C\", \"body\": \"c\"}]\nassert all(set(d) == {\"id\", \"title\", \"body\"} for d in list_documents(c, \"t\", \"o\"))\nprint(\"access_scope ok\")\nEOF\npython3 checks/public.py && echo public ok && python3 checks/access_scope.py",
          "timeout": 60000
