  "grade": {
    "scope": {
      "files": {
        "checks/public.cjs": "const assert = require('node:assert/strict');\n\n        const { DocumentRepository } = require('../.build/repository');\n        const { DocumentService } = require('../.build/service');\n        const repo = new DocumentRepository([{ id: 'one', tenant: 'a', owner: 'u', deleted: false, archived: false }]);\n        const service = new DocumentService(repo); const admin = { tenant: 'a', user: 'u', role: 'admin' };\n        service.archive(admin, 'one'); assert.equal(repo.documents[0].archived, true);\n        service.archive(admin, 'one'); assert.deepEqual(repo.audit, [{ actor: 'u', document: 'one' }]);\n        assert.throws(() => service.archive(admin, 'missing'), /not found/);\n\n// Authorization rules for DocumentService.archive.\n{\n  // Fixture: \"a\" is the actor's tenant, \"b\" is a foreign tenant. Built fresh for each scenario.\n  const fixture = () => new DocumentRepository([\n    { id: 'own', tenant: 'a', owner: 'alice', deleted: false, archived: false },\n    { id: 'other', tenant: 'a', owner: 'bob', deleted: false, archived: false },\n    { id: 'carol-doc', tenant: 'a', owner: 'carol', deleted: false, archived: false },\n    { id: 'own-done', tenant: 'a', owner: 'alice', deleted: false, archived: true },\n    { id: 'other-done', tenant: 'a', owner: 'bob', deleted: false, archived: true },\n    { id: 'gone', tenant: 'a', owner: 'alice', deleted: true, archived: false },\n    { id: 'foreign', tenant: 'b', owner: 'alice', deleted: false, archived: false },\n    { id: 'foreign-done', tenant: 'b', owner: 'alice', deleted: false, archived: true },\n  ]);\n  const root = { tenant: 'a', user: 'root', role: 'admin' };\n  const alice = { tenant: 'a', user: 'alice', role: 'editor' };\n  const bob = { tenant: 'a', user: 'bob', role: 'editor' };\n  const carol = { tenant: 'a', user: 'carol', role: 'viewer' };\n  const rootB = { tenant: 'b', user: 'root-b', role: 'admin' };\n  const unknownRole = { tenant: 'a', user: 'alice', role: 'owner' };\n  const snapshot = (repo) => structuredClone({ documents: repo.documents, audit: repo.audit });\n\n  // A rejected call must throw exactly Error(reason) and leave documents and audit unchanged.\n  const rejects = (repo, service, actor, id, reason, label) => {\n    const before = snapshot(repo);\n    assert.throws(() => service.archive(actor, id), (err) => {\n      assert.ok(err instanceof Error, `${label}: expected an Error`);\n      assert.equal(err.message, reason, label);\n      return true;\n    }, label);\n    assert.deepEqual(snapshot(repo), before, `${label}: state changed`);\n  };\n\n  // [actor, document id, outcome] on a fresh fixture. Outcome is 'ok' (archived, one audit entry),\n  // 'noop' (already archived and permitted: nothing changes), or the Error message expected on throw.\n  const outcomes = [\n    [root, 'own', 'ok'], [root, 'other', 'ok'], [root, 'carol-doc', 'ok'],\n    [root, 'own-done', 'noop'], [root, 'other-done', 'noop'],\n    [root, 'gone', 'not found'], [root, 'foreign', 'not found'],\n    [root, 'foreign-done', 'not found'], [root, 'missing', 'not found'],\n    [alice, 'own', 'ok'], [alice, 'own-done', 'noop'],\n    [alice, 'other', 'forbidden'], [alice, 'other-done', 'forbidden'], [alice, 'carol-doc', 'forbidden'],\n    [alice, 'gone', 'not found'], [alice, 'foreign', 'not found'],\n    [alice, 'foreign-done', 'not found'], [alice, 'missing', 'not found'],\n    [bob, 'other', 'ok'], [bob, 'other-done', 'noop'], [bob, 'own', 'forbidden'], [bob, 'own-done', 'forbidden'],\n    [carol, 'carol-doc', 'forbidden'], [carol, 'own', 'forbidden'], [carol, 'own-done', 'forbidden'],\n    [carol, 'other-done', 'forbidden'], [carol, 'gone', 'not found'], [carol, 'foreign', 'not found'],\n    [carol, 'foreign-done', 'not found'], [carol, 'missing', 'not found'],\n    [rootB, 'foreign', 'ok'], [rootB, 'foreign-done', 'noop'], [rootB, 'own', 'not found'],\n    [rootB, 'own-done', 'not found'], [rootB, 'gone', 'not found'], [rootB, 'missing', 'not found'],\n    [unknownRole, 'own', 'forbidden'], [unknownRole, 'gone', 'not found'],\n  ];\n  for (const [actor, id, outcome] of outcomes) {\n    const label = `${actor.user}/${actor.role}@${actor.tenant} archive ${id}`;\n    const repo = fixture();\n    const service = new DocumentService(repo);\n    if (outcome === 'ok' || outcome === 'noop') {\n      const before = snapshot(repo);\n      service.archive(actor, id);\n      const documents = before.documents.map((d) => (outcome === 'ok' && d.id === id ? { ...d, archived: true } : d));\n      const audit = outcome === 'ok' ? [{ actor: actor.user, document: id }] : [];\n      assert.deepEqual(snapshot(repo), { documents, audit }, label);\n    } else {\n      rejects(repo, service, actor, id, outcome, label);\n    }\n  }\n\n  // Failures interleaved with successes never touch documents or the audit.\n  {\n    const repo = fixture();\n    const service = new DocumentService(repo);\n    service.archive(root, 'own');\n    service.archive(alice, 'own-done'); // permitted repeat: must not append\n    rejects(repo, service, bob, 'own', 'forbidden', 'bob on root-archived own');\n    rejects(repo, service, carol, 'carol-doc', 'forbidden', 'viewer on own doc');\n    rejects(repo, service, rootB, 'own', 'not found', 'foreign admin on tenant a doc');\n    rejects(repo, service, alice, 'other', 'forbidden', 'editor on other owner doc');\n    service.archive(bob, 'other');\n    assert.deepEqual(repo.audit, [\n      { actor: 'root', document: 'own' },\n      { actor: 'bob', document: 'other' },\n    ]);\n  }\n}\n",
        "src/service.ts": "import { Actor } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    // Only active (not deleted) documents in the actor's tenant are visible. Missing, deleted and\n    // foreign-tenant documents all report \"not found\", even to admins.\n    if (!document || document.deleted || document.tenant !== actor.tenant) throw new Error('not found');\n    // Admins may archive any visible document, editors only the ones they own, viewers never.\n    // Any other role is denied.\n    const permitted = actor.role === 'admin' || (actor.role === 'editor' && document.owner === actor.user);\n    if (!permitted) throw new Error('forbidden');\n    // Archiving an already archived document is a no-op: no state change and no audit entry.\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n}\n"
