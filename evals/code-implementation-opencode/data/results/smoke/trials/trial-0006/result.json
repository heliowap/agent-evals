          "command": "cat >> src/numbers.py <<'EOF'\n\n\ndef clamp(value, lower, upper):\n    \"\"\"Return value constrained to the inclusive bounds.\"\"\"\n    if lower > upper:\n        raise ValueError(\"lower must not exceed upper\")\n    if value < lower:\n        return lower\n    if value > upper:\n        return upper\n    return value\nEOF\ncat > checks/public.py <<'EOF'\nimport sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path.cwd()))\nfrom src.numbers import add, clamp\n\nassert add(2, 3) == 5\nassert add(-2, 3) == 1\n\nassert clamp(5, 0, 10) == 5\nassert clamp(-1, 0, 10) == 0\nassert clamp(11, 0, 10) == 10\nassert clamp(0, 0, 10) == 0\nassert clamp(10, 0, 10) == 10\nassert clamp(-5, -10, -1) == -5\nassert clamp(1.5, 0.5, 2.5) == 1.5\nassert clamp(0.1, 0.5, 2.5) == 0.5\nassert clamp(3.0, 0.5, 2.5) == 2.5\nfor value in (0, 5, 10):\n    assert clamp(value, 5, 5) == 5\n\nfor value in (0, 5, 10):\n    try:\n        clamp(value, 10, 0)\n    except ValueError:\n        pass\n    else:\n        raise AssertionError(\"clamp must reject reversed bounds\")\nEOF\npython3 checks/public.py"
