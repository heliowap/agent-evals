        "checks/public.py": "import sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path.cwd()))\nfrom src.numbers import add, clamp\n\nassert add(2, 3) == 5\n\n# Inside bounds returns value unchanged\nassert clamp(5, 0, 10) == 5\nassert clamp(0, 0, 10) == 0\nassert clamp(10, 0, 10) == 10\n\n# Below lower bound clamps up\nassert clamp(-3, 0, 10) == 0\n\n# Above upper bound clamps down\nassert clamp(42, 0, 10) == 10\n\n# Degenerate bound (lower == upper) always returns that bound\nassert clamp(7, 4, 4) == 4\n\n# Works with floats\nassert clamp(0.5, 0.0, 1.0) == 0.5\nassert clamp(-1.5, 0.0, 1.0) == 0.0\nassert clamp(2.5, 0.0, 1.0) == 1.0\n\n# Reversed bounds raise ValueError\nfor bad in ((10, 5, 0), (0, 1, -1), (0.0, 2.5, -2.5)):\n    try:\n        clamp(*bad)\n    except ValueError:\n        pass\n    else:\n        raise AssertionError(f\"expected ValueError for clamp{bad}\")\n\nprint(\"All checks passed.\")\n",
        "src/numbers.py": "def add(left, right):\n    return left + right\n\n\ndef clamp(value, lower, upper):\n    if lower > upper:\n        raise ValueError(\"lower must not be greater than upper\")\n    if value < lower:\n        return lower\n    if value > upper:\n        return upper\n    return value\n"
