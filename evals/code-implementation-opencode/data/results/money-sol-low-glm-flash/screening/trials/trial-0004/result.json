      "state": {
        "status": "completed",
        "input": {
          "command": "cat > src/money.py <<'EOF'\nfrom decimal import Decimal\nimport re\n\n\n_AMOUNT_PATTERN = re.compile(r\"[+-]?[0-9]+(?:\\.[0-9]+)?\")\n_MAX_AMOUNT = Decimal(\"1000000.00\")\n\n\ndef parse_amount(value):\n    if isinstance(value, bool):\n        raise ValueError(\"Invalid amount type\")\n    if isinstance(value, str):\n        if _AMOUNT_PATTERN.fullmatch(value) is None:\n            raise ValueError(\"Invalid amount syntax\")\n        amount = Decimal(value)\n    elif isinstance(value, (Decimal, int)):\n        amount = Decimal(value)\n    else:\n        raise ValueError(\"Invalid amount type\")\n\n    if not amount.is_finite() or amount <= 0 or amount > _MAX_AMOUNT:\n        raise ValueError(\"Amount must be positive and at most 1000000.00\")\n\n    # Work on the coefficient rather than performing context-sensitive decimal\n    # arithmetic. Removing only zero digits never rounds a fractional cent.\n    _, digits, exponent = amount.as_tuple()\n    if exponent < -2:\n        extra = -2 - exponent\n        if extra >= len(digits) or any(digits[-extra:]):\n            raise ValueError(\"Amount must be exactly representable in cents\")\n        digits = digits[:-extra]\n    else:\n        digits = digits + (0,) * (exponent + 2)\n    return Decimal((0, digits, -2))\n\n\ndef format_amount(value):\n    return format(value, \".2f\")\nEOF\ncat > src/api.py <<'EOF'\nfrom decimal import Decimal\n\nfrom .money import parse_amount, format_amount\n\n\ndef make_invoice(amounts):\n    if not isinstance(amounts, list):\n        raise ValueError(\"Amounts must be a list\")\n\n    # Validated amounts have exponent -2, so their coefficients are integer\n    # cents. Integer addition is exact regardless of the decimal context.\n    total_cents = 0\n    for item in amounts:\n        amount = parse_amount(item)\n        cents = 0\n        for digit in amount.as_tuple().digits:\n            cents = cents * 10 + digit\n        total_cents += cents\n        if total_cents > 100000000:\n            raise ValueError(\"Invoice total exceeds 1000000.00\")\n\n    total = Decimal((0, tuple(int(digit) for digit in str(total_cents)), -2))\n    return {\"total\": format_amount(total), \"count\": len(amounts)}\nEOF\npython3 checks/public.py"
        },
