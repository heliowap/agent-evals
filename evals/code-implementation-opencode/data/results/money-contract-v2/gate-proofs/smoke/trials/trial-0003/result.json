        "input": {
          "command": "cat > /workspace/src/numbers.py <<'EOF'\ndef add(left, right):\n    return left + right\n\n\ndef clamp(value, lower, upper):\n    if lower > upper:\n        raise ValueError(\"lower must not be greater than upper\")\n    if value < lower:\n        return lower\n    if value > upper:\n        return upper\n    return value\nEOF\ncat > /workspace/checks/public.py <<'EOF'\nimport sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path.cwd()))\nfrom src.numbers import add, clamp\n\nassert add(2, 3) == 5\n\nassert clamp(5, 1, 10) == 5\nassert clamp(0, 1, 10) == 1\nassert clamp(11, 1, 10) == 10\nassert clamp(1, 1, 10) == 1\nassert clamp(10, 1, 10) == 10\nassert clamp(7, 7, 7) == 7\nassert clamp(-5.5, -1.0, 1.0) == -1.0\n\ntry:\n    clamp(5, 10, 1)\nexcept ValueError:\n    pass\nelse:\n    raise AssertionError(\"clamp must raise ValueError when lower > upper\")\n\nprint(\"public checks passed\")\nEOF\ncd /workspace && python3 checks/public.py"
