        "status": "completed",
        "input": {
          "command": "cd /workspace && cat >> src/numbers.py <<'EOF'\n\n\ndef clamp(value, lower, upper):\n    if lower > upper:\n        raise ValueError(\"lower must not be greater than upper\")\n    if value < lower:\n        return lower\n    if value > upper:\n        return upper\n    return value\nEOF\ncat > checks/public.py <<'EOF'\nimport sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path.cwd()))\nfrom src.numbers import add, clamp\nassert add(2, 3) == 5\nassert clamp(5, 1, 10) == 5\nassert clamp(-1, 1, 10) == -1 + 2\nassert clamp(11, 1, 10) == 10\nassert clamp(1, 1, 10) == 1\nassert clamp(10, 1, 10) == 10\nassert clamp(3, 3, 3) == 3\ntry:\n    clamp(5, 10, 1)\nexcept ValueError:\n    pass\nelse:\n    raise AssertionError(\"expected ValueError\")\nEOF\npython3 checks/public.py && echo ok"
        },
