    "scope": {
      "files": {
        "src/api.py": "from .money import parse_amount, format_amount, _to_cents, _from_cents, _MAX_CENTS\n\n\ndef make_invoice(amounts):\n    if type(amounts) is not list:\n        raise ValueError(\"amounts must be a list\")\n    total = 0\n    for item in amounts:\n        total += _to_cents(item)\n        if total > _MAX_CENTS:\n            raise ValueError(\"total too large\")\n    return {\"total\": format_amount(_from_cents(total)), \"count\": len(amounts)}\n",
        "src/money.py": "import re\nfrom decimal import Decimal\n\n_MAX_CENTS = 100000000  # 1000000.00\n_PATTERN = re.compile(r\"[+-]?[0-9]+(?:\\.[0-9]+)?\")\n\n\ndef _to_cents(value):\n    \"\"\"Validate value and return exact integer number of cents (> 0).\"\"\"\n    if isinstance(value, bool):\n        raise ValueError(\"invalid amount\")\n    if isinstance(value, str):\n        if not _PATTERN.fullmatch(value):\n            raise ValueError(\"invalid amount\")\n        value = Decimal(value)  # construction is exact, ignores context\n    elif isinstance(value, int):\n        value = Decimal(value)\n    elif not isinstance(value, Decimal):\n        raise ValueError(\"invalid amount\")\n    if not value.is_finite():\n        raise ValueError(\"invalid amount\")\n    # Comparisons are exact and independent of context precision.\n    if value <= 0 or value > Decimal(_MAX_CENTS) / 100:\n        raise ValueError(\"amount out of range\")\n    sign, digits, exp = value.as_tuple()\n    n = int(\"\".join(map(str, digits)))\n    if exp >= -2:\n        n *= 10 ** (exp + 2)\n    else:\n        shift = -2 - exp\n        # Avoid huge powers: reject if more than `shift` digits can't be dropped.\n        if shift > len(digits):\n            raise ValueError(\"not representable in cents\")\n        q, r = divmod(n, 10 ** shift)\n        if r:\n            raise ValueError(\"not representable in cents\")\n        n = q\n    if n <= 0 or n > _MAX_CENTS:\n        raise ValueError(\"amount out of range\")\n    return n\n\n\ndef _from_cents(n):\n    return Decimal((0, tuple(int(c) for c in str(n)), -2)) if n else Decimal((0, (0,), -2))\n\n\ndef parse_amount(value):\n    return _from_cents(_to_cents(value))\n\n\ndef format_amount(value):\n    return format(value, \".2f\")\n"
