'[{\"id\":\"0\",\"name\":\"Zoë,\\\\\"雪\\\\\"\\\\nnext\"},{\"id\":\"\",\"name\":\"False\"},{\"id\":\"\",\"name\":\"\"},{\"id\":\"2.5\",\"name\":\"\\\\r\\\\n\"}]',\n}\nfor format, wrapper in ((\"csv\", export_csv), (\"json\", export_json)):\n    for call in (wrapper, lambda rows: export_rows(rows, format),\n                 lambda rows: export(rows, format)):\n        assert call(OneShot(rows)) == expected[format]\n        assert call(iter(())) == (\"id,name\\n\" if format == \"csv\" else \"[]\")\n    assert rows == original\n\nfor call in (export_rows, export):\n    try:\n        call(None, \"unsupported\")\n    except ValueError as error:\n        assert str(error) == \"unsupported format\"\n    else:\n        raise AssertionError(\"unsupported format accepted\")\n\nfor module, wrapper, format in (\n    (\"src.csv_exporter\", export_csv, \"csv\"),\n    (\"src.json_exporter\", export_json, \"json\"),\n):\n    with patch(module + \".export_rows\", return_value=\"shared\") as shared:\n        assert wrapper(rows) == \"shared\"\n        shared.assert_called_once_with(rows, format)\nEOF\npython3 checks/public.py && python3 checks/exporter.py"
