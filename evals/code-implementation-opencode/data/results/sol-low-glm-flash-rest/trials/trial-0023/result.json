      "state": {
        "status": "completed",
        "input": {
          "command": "cat > src/service.py <<'EOF'\ndef stream_rows(resource, transform):\n    failed = False\n    try:\n        while True:\n            try:\n                row = resource.read_next()\n                if row is None:\n                    return\n                value = transform(row)\n            except BaseException:\n                failed = True\n                raise\n            yield value\n    finally:\n        try:\n            resource.close()\n        except BaseException:\n            # Cleanup must not replace a read or transformation failure.\n            if not failed:\n                raise\nEOF\ncat > src/consumer.py <<'EOF'\nfrom .service import stream_rows\n\n\ndef take(resource, transform, limit):\n    if limit == 0:\n        return []\n\n    stream = stream_rows(resource, transform)\n    result = []\n    failed = False\n    try:\n        for row in stream:\n            result.append(row)\n            if len(result) >= limit:\n                break\n        return result\n    except BaseException:\n        failed = True\n        raise\n    finally:\n        try:\n            stream.close()\n        except BaseException:\n            if not failed:\n                raise\nEOF\ncat > checks/lifecycle.py <<'EOF'\nimport os\nimport sys\n\nsys.path.insert(0, os.getcwd())\nfrom src.consumer import take\nfrom src.resource import Rows\nfrom src.service import stream_rows\n\n\nclass FailingRows(Rows):\n    def __init__(self, rows, read_error=None, close_error=None):\n        super().__init__(rows)\n        self.read_error = read_error\n        self.close_error = close_error\n\n    def read_next(self):\n        if self.read_error is not None:\n            self.reads += 1\n            raise self.read_error\n        return super().read_next()\n\n    def close(self):\n        super().close()\n        if self.close_error is not None:\n            raise self.close_error\n\n\ndef raises_same(error, action):\n    try:\n        action()\n    except BaseException as caught:\n        assert caught is error\n    else:\n        raise AssertionError('Expected error')\n\n\nidentity = lambda row: row\nr = Rows([1, 2])\ns = stream_rows(r, identity)\nassert (r.reads, r.closes) == (0, 0)\ns.close()\nassert (r.reads, r.closes) == (0, 0)\n\nr = Rows([1, 2, 3])\ns = stream_rows(r, lambda row: row * 2)\nassert next(s) == 2\nassert (r.reads, r.closes) == (1, 0)\ns.close()\ns.close()\nassert (r.reads, r.closes) == (1, 1)\n\nfor cleanup_error in (None, RuntimeError('cleanup')):\n    error = ValueError('read')\n    r = FailingRows([1], error, cleanup_error)\n    s = stream_rows(r, identity)\n    raises_same(error, lambda: next(s))\n    s.close()\n    assert (r.reads, r.closes) == (1, 1)\n\n    error = ValueError('transform')\n    r = FailingRows([1, 2], close_error=cleanup_error)\n\n    def fail(row):\n        raise error\n\n    s = stream_rows(r, fail)\n    raises_same(error, lambda: next(s))\n    assert list(s) == []\n    assert (r.reads, r.closes) == (1, 1)\n\nfor exhaust in (False, True):\n    error = RuntimeError('cleanup')\n    r = FailingRows([1], close_error=error)\n    s = stream_rows(r, identity)\n    assert next(s) == 1\n    raises_same(error, (lambda: next(s)) if exhaust else s.close)\n    s.close()\n    assert r.closes == 1\n\nr = Rows([1, 2, 3])\nassert take(r, lambda row: row * 2, 2) == [2, 4]\nassert (r.reads, r.closes) == (2, 1)\nr = Rows([1])\nassert take(r, identity, 0) == []\nassert (r.reads, r.closes) == (0, 0)\nr = Rows([1])\nassert take(r, identity, 3) == [1]\nassert (r.reads, r.closes) == (2, 1)\nerror = ValueError('consume')\nr = FailingRows([1, 2], close_error=RuntimeError('cleanup'))\n\n\ndef fail(row):\n    raise error\n\n\nraises_same(error, lambda: take(r, fail, 1))\nassert (r.reads, r.closes) == (1, 1)\nerror = RuntimeError('cleanup')\nr = FailingRows([1, 2], close_error=error)\nraises_same(error, lambda: take(r, identity, 1))\nassert (r.reads, r.closes) == (1, 1)\nEOF\npython3 checks/public.py && python3 checks/lifecycle.py"
