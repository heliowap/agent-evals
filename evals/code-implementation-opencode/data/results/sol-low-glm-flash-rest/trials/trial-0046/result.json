ion, payload[\\\"email\\\"], payload[\\\"name\\\"])\\n    return {\\\"ok\\\": True}\\n\\ndef handle_import(connection, payload):\\n    raise NotImplementedError(\\\"Batch endpoint is unavailable\\\")\\n\",\"exit_code\":0,\"signal\":null,\"cancelled\":false,\"timeout\":false,\"truncated\":false}"
