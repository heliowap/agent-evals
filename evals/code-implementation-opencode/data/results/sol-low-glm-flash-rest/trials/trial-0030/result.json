    "scope": {
      "files": {
        "checks/authorization.cjs": "const assert = require('node:assert/strict');\nconst { DocumentRepository } = require('../.build/repository');\nconst { DocumentService } = require('../.build/service');\n\n// Exercise visibility and permissions for both fresh and already archived documents.\nfor (const role of ['admin', 'editor', 'viewer']) {\n  for (const owner of ['user', 'other']) {\n    for (const archived of [false, true]) {\n      for (const visibility of ['visible', 'missing', 'deleted', 'foreign']) {\n        const document = {\n          id: 'one', tenant: visibility === 'foreign' ? 'other' : 'tenant',\n          owner, deleted: visibility === 'deleted', archived,\n        };\n        const repo = new DocumentRepository(visibility === 'missing' ? [] : [document]);\n        repo.audit.push({ actor: 'previous', document: 'previous' });\n        const service = new DocumentService(repo);\n        const actor = { tenant: 'tenant', user: 'user', role };\n        const before = JSON.parse(JSON.stringify({ documents: repo.documents, audit: repo.audit }));\n        const error = visibility !== 'visible' ? 'not found'\n          : role === 'admin' || (role === 'editor' && owner === 'user') ? null : 'forbidden';\n        if (error) {\n          assert.throws(() => service.archive(actor, 'one'), { message: error });\n          assert.deepEqual({ documents: repo.documents, audit: repo.audit }, before);\n        } else {\n          service.archive(actor, 'one');\n          assert.deepEqual(repo.documents, [{ ...document, archived: true }]);\n          assert.deepEqual(repo.audit, archived ? before.audit\n            : [...before.audit, { actor: 'user', document: 'one' }]);\n          const audit = repo.audit.slice();\n          service.archive(actor, 'one');\n          assert.deepEqual(repo.audit, audit);\n        }\n      }\n    }\n  }\n}\n",
        "src/service.ts": "import { Actor } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    if (!document || document.deleted || document.tenant !== actor.tenant) {\n      throw new Error('not found');\n    }\n    if (actor.role !== 'admin' && !(actor.role === 'editor' && document.owner === actor.user)) {\n      throw new Error('forbidden');\n    }\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n}\n"
      },
