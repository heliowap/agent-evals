      "files": {
        "checks/public.cjs": "const assert = require('node:assert/strict');\n\n        const { DocumentRepository } = require('../.build/repository');\n        const { DocumentService } = require('../.build/service');\n        const repo = new DocumentRepository([{ id: 'one', tenant: 'a', owner: 'u', deleted: false, archived: false }]);\n        const service = new DocumentService(repo); const admin = { tenant: 'a', user: 'u', role: 'admin' };\n        service.archive(admin, 'one'); assert.equal(repo.documents[0].archived, true);\n        service.archive(admin, 'one'); assert.deepEqual(repo.audit, [{ actor: 'u', document: 'one' }]);\n        assert.throws(() => service.archive(admin, 'missing'), /not found/);\n\n// Exercise visibility, permission ordering, idempotency, and failure atomicity.\nfor (const role of ['admin', 'editor', 'viewer']) {\n  for (const owns of [false, true]) {\n    for (const archived of [false, true]) {\n      for (const visibility of ['visible', 'deleted', 'foreign', 'missing']) {\n        const documents = [\n          { id: 'target', tenant: visibility === 'foreign' ? 'b' : 'a',\n            owner: owns ? 'actor' : 'other', deleted: visibility === 'deleted', archived },\n          { id: 'untouched', tenant: 'a', owner: 'actor', deleted: false, archived: false },\n        ];\n        const repository = new DocumentRepository(documents);\n        repository.audit.push({ actor: 'previous', document: 'previous' });\n        const before = structuredClone({ documents, audit: repository.audit });\n        const subject = new DocumentService(repository);\n        const actor = { tenant: 'a', user: 'actor', role };\n        const id = visibility === 'missing' ? 'absent' : 'target';\n        const error = visibility !== 'visible' ? 'not found'\n          : role === 'admin' || (role === 'editor' && owns) ? null : 'forbidden';\n        if (error) {\n          assert.throws(() => subject.archive(actor, id), { message: error });\n          assert.deepEqual({ documents, audit: repository.audit }, before);\n        } else {\n          subject.archive(actor, id);\n          const expected = structuredClone(before);\n          expected.documents[0].archived = true;\n          if (!archived) expected.audit.push({ actor: 'actor', document: id });\n          assert.deepEqual({ documents, audit: repository.audit }, expected);\n          subject.archive(actor, id);\n          assert.deepEqual({ documents, audit: repository.audit }, expected);\n        }\n      }\n    }\n  }\n}\n",
        "src/service.ts": "import { Actor } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    if (!document || document.deleted || document.tenant !== actor.tenant) {\n      throw new Error('not found');\n    }\n    if (actor.role !== 'admin' && !(actor.role === 'editor' && document.owner === actor.user)) {\n      throw new Error('forbidden');\n    }\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n}\n"
