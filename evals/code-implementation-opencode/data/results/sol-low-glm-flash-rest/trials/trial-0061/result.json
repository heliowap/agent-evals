    "scope": {
      "files": {
        "checks/public.cjs": "const assert = require('node:assert/strict');\n\n        const { DocumentRepository } = require('../.build/repository');\n        const { DocumentService } = require('../.build/service');\n        const repo = new DocumentRepository([{ id: 'one', tenant: 'a', owner: 'u', deleted: false, archived: false }]);\n        const service = new DocumentService(repo); const admin = { tenant: 'a', user: 'u', role: 'admin' };\n        service.archive(admin, 'one'); assert.equal(repo.documents[0].archived, true);\n        service.archive(admin, 'one'); assert.deepEqual(repo.audit, [{ actor: 'u', document: 'one' }]);\n        assert.throws(() => service.archive(admin, 'missing'), /not found/);\n\n// Visibility and permissions apply even when archiving would otherwise be a no-op.\nfor (const role of ['admin', 'editor', 'viewer']) {\n  for (const archived of [false, true]) {\n    for (const kind of ['missing', 'deleted', 'foreign', 'owned', 'other']) {\n      const documents = [\n        { id: 'target', tenant: kind === 'foreign' ? 'b' : 'a', owner: kind === 'other' ? 'other' : 'u', deleted: kind === 'deleted', archived },\n        { id: 'untouched', tenant: 'a', owner: 'u', deleted: false, archived: false },\n      ];\n      const repository = new DocumentRepository(documents);\n      repository.audit.push({ actor: 'prior', document: 'prior' });\n      const before = JSON.parse(JSON.stringify({ documents, audit: repository.audit }));\n      const documentService = new DocumentService(repository);\n      const actor = { tenant: 'a', user: 'u', role };\n      const id = kind === 'missing' ? 'absent' : 'target';\n      const invisible = ['missing', 'deleted', 'foreign'].includes(kind);\n      const forbidden = role === 'viewer' || (role === 'editor' && kind === 'other');\n      if (invisible || forbidden) {\n        assert.throws(() => documentService.archive(actor, id), { message: invisible ? 'not found' : 'forbidden' });\n        assert.deepEqual({ documents, audit: repository.audit }, before);\n      } else {\n        documentService.archive(actor, id);\n        before.documents[0].archived = true;\n        if (!archived) before.audit.push({ actor: 'u', document: id });\n        assert.deepEqual({ documents, audit: repository.audit }, before);\n        documentService.archive(actor, id);\n        assert.deepEqual({ documents, audit: repository.audit }, before);\n      }\n    }\n  }\n}\n",
        "src/service.ts": "import { Actor } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    if (!document || document.deleted || document.tenant !== actor.tenant) {\n      throw new Error('not found');\n    }\n    if (actor.role !== 'admin' && !(actor.role === 'editor' && document.owner === actor.user)) {\n      throw new Error('forbidden');\n    }\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n}\n"
