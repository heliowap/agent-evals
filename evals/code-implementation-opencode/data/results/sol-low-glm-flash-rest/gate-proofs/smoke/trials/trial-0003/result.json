          "command": "cd /workspace && cat > src/numbers.py <<'EOF'\ndef add(left, right):\n    return left + right\n\n\ndef clamp(value, lower, upper):\n    if lower > upper:\n        raise ValueError(\"lower must not be greater than upper\")\n    if value < lower:\n        return lower\n    if value > upper:\n        return upper\n    return value\nEOF\ncat > checks/public.py <<'EOF'\nimport sys\nfrom pathlib import Path\nsys.path.insert(0, str(Path.cwd()))\nfrom src.numbers import add, clamp\nassert add(2, 3) == 5\nassert clamp(5, 0, 10) == 5\nassert clamp(-1, 0, 10) == 0\nassert clamp(11, 0, 10) == 10\nassert clamp(0, 0, 10) == 0\nassert clamp(10, 0, 10) == 10\ntry:\n    clamp(5, 10, 0)\n    raise AssertionError(\"expected ValueError\")\nexcept ValueError:\n    pass\nEOF\npython3 checks/public.py && echo OK"
