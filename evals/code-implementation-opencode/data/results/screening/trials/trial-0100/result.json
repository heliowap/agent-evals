        "src/money.ts": "export function formatAmount(cents: number): string {\n  const sign = cents < 0 ? '-' : '';\n  const absolute = Math.abs(cents);\n  return sign + Math.floor(absolute / 100) + '.' + String(absolute % 100).padStart(2, '0');\n}\n",
        "src/report.ts": "import { formatAmount } from './money';\nexport function renderReport(rows: { id: string; cents: number }[]): string {\n  return rows.map(row => row.id + ',' + formatAmount(row.cents)).join('\\n');\n}\n",
