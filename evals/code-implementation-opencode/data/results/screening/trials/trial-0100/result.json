        "checks/public.cjs": "const assert = require('node:assert/strict');\n\n        const { renderInvoice } = require('../.build/invoice'); const { renderReport } = require('../.build/report');\n        assert.equal(renderInvoice('inv', 123), 'inv: $1.23');\n        assert.equal(renderReport([{ id: 'a', cents: 0 }, { id: 'b', cents: -1 }]), 'a,0.00\\nb,-0.01');\n\nconst { formatAmount } = require('../.build/money');\nfor (const [cents, expected] of [[0, '0.00'], [1, '0.01'], [-1, '-0.01'], [99, '0.99'], [100, '1.00'], [123, '1.23'], [-123, '-1.23'], [-100, '-1.00'], [123456, '1234.56'], [-123456, '-1234.56']]) {\n  assert.equal(formatAmount(cents), expected);\n  assert.equal(renderInvoice('i', cents), 'i: $' + expected);\n}\nassert.equal(renderReport([{ id: 'z', cents: 500 }, { id: 'a', cents: -7 }, { id: 'm', cents: 0 }]), 'z,5.00\\na,-0.07\\nm,0.00');\nassert.equal(renderReport([]), '');\nfor (const mod of ['invoice', 'report', 'money']) {\n  const exportsOf = require('../.build/' + mod);\n  assert.ok(!('invoiceAmount' in exportsOf) && !('reportAmount' in exportsOf));\n}\n",
        "src/invoice.ts": "import { formatAmount } from './money';\nexport function renderInvoice(id: string, cents: number): string { return id + ': $' + formatAmount(cents); }\n",
