      "state": {
        "status": "completed",
        "input": {
          "command": "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/service.py')\ns = p.read_text().replace('find(connection, document_id)', 'find(connection, tenant, owner, document_id)').replace('listing(connection, owner)', 'listing(connection, tenant, owner)')\np.write_text(s)\np = Path('src/repository.py')\ns = p.read_text()\ns = s[:s.index('def find(')] + '''def find(connection, tenant, owner, document_id):\n    row = connection.execute(\n        \"SELECT id, title, body FROM documents \"\n        \"WHERE id=? AND tenant=? AND owner=? AND deleted_at IS NULL\",\n        (document_id, tenant, owner),\n    ).fetchone()\n    return None if row is None else decode(row)\n\ndef listing(connection, tenant, owner):\n    rows = connection.execute(\n        \"SELECT id, title, body FROM documents \"\n        \"WHERE tenant=? AND owner=? AND deleted_at IS NULL ORDER BY id\",\n        (tenant, owner),\n    )\n    return [decode(row) for row in rows]\n'''\np.write_text(s)\nPY\ncat > checks/security.py <<'PY'\nimport os\nimport sqlite3\nimport sys\nimport unittest\n\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n\nfrom src.repository import initialize\nfrom src.service import get_document, list_documents\n\n\nclass DocumentAccessTests(unittest.TestCase):\n    def setUp(self):\n        self.connection = sqlite3.connect(\":memory:\")\n        self.addCleanup(self.connection.close)\n        initialize(self.connection)\n        self.connection.executemany(\n            \"INSERT INTO documents VALUES (?, ?, ?, ?, ?, ?)\",\n            [\n                (5, \"t\", \"o\", \"Last\", \"Last body\", None),\n                (1, \"t\", \"o\", \"First\", \"First body\", None),\n                (2, \"other\", \"o\", \"Other tenant\", \"Body\", None),\n                (3, \"t\", \"other\", \"Other owner\", \"Body\", None),\n                (4, \"t\", \"o\", \"Deleted\", \"Body\", \"2026-01-01\"),\n                (6, \"t\", \"o\", \"Also deleted\", \"Body\", \"\"),\n                (7, \"tenant' OR 1=1 --\", \"owner's\", \"Quoted\", \"Body\", None),\n            ],\n        )\n\n    def test_get_only_returns_accessible_documents(self):\n        self.assertEqual(\n            get_document(self.connection, \"t\", \"o\", 1),\n            {\"id\": 1, \"title\": \"First\", \"body\": \"First body\"},\n        )\n        for document_id in (2, 3, 4, 6, 99, \"1 OR 1=1\"):\n            with self.subTest(document_id=document_id):\n                self.assertIsNone(get_document(self.connection, \"t\", \"o\", document_id))\n\n    def test_list_filters_and_orders_without_metadata(self):\n        self.assertEqual(\n            list_documents(self.connection, \"t\", \"o\"),\n            [\n                {\"id\": 1, \"title\": \"First\", \"body\": \"First body\"},\n                {\"id\": 5, \"title\": \"Last\", \"body\": \"Last body\"},\n            ],\n        )\n        self.assertEqual(list_documents(self.connection, \"missing\", \"o\"), [])\n\n    def test_quoted_names_are_literal_parameters(self):\n        expected = {\"id\": 7, \"title\": \"Quoted\", \"body\": \"Body\"}\n        self.assertEqual(\n            get_document(self.connection, \"tenant' OR 1=1 --\", \"owner's\", 7),\n            expected,\n        )\n        self.assertEqual(\n            list_documents(self.connection, \"tenant' OR 1=1 --\", \"owner's\"),\n            [expected],\n        )\n        self.assertIsNone(get_document(self.connection, \"t\", \"o' OR 1=1 --\", 1))\n        self.assertEqual(list_documents(self.connection, \"t\", \"o' OR 1=1 --\"), [])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nPY\npython3 checks/public.py && python3 checks/security.py"
        },
