        "input": {
          "command": "cat > src/exporter.py <<'EOF'\nimport csv\nimport io\nimport json\n\n\ndef _normalize_rows(rows):\n    for row in rows:\n        yield {\n            key: \"\" if row.get(key) is None else str(row[key])\n            for key in (\"id\", \"name\")\n        }\n\n\ndef export_rows(rows, format):\n    if format not in (\"csv\", \"json\"):\n        raise ValueError(\"unsupported format\")\n\n    clean = _normalize_rows(rows)\n    if format == \"json\":\n        return json.dumps(list(clean), ensure_ascii=False, separators=(\",\", \":\"))\n\n    buffer = io.StringIO(newline=\"\")\n    writer = csv.writer(buffer, lineterminator=\"\\n\")\n    writer.writerow([\"id\", \"name\"])\n    writer.writerows((row[\"id\"], row[\"name\"]) for row in clean)\n    return buffer.getvalue()\nEOF\ncat > src/csv_exporter.py <<'EOF'\nfrom .exporter import export_rows\n\n\ndef export_csv(rows):\n    return export_rows(rows, \"csv\")\nEOF\ncat > src/json_exporter.py <<'EOF'\nfrom .exporter import export_rows\n\n\ndef export_json(rows):\n    return export_rows(rows, \"json\")\nEOF\ncat > checks/exporter.py <<'EOF'\nimport copy\nimport os\nimport sys\nimport unittest\nfrom unittest.mock import patch\n\nsys.path.insert(0, os.getcwd())\nfrom src.csv_exporter import export_csv\nfrom src.dispatcher import export\nfrom src.exporter import export_rows\nfrom src.json_exporter import export_json\n\n\nclass ExportTests(unittest.TestCase):\n    def test_exact_output_and_unmodified_inputs(self):\n        rows = [\n            {\"name\": 'Zoë,\"猫\"\\nnext', \"id\": 0, \"extra\": \"ignored\"},\n            {\"id\": None, \"name\": False},\n            {\"name\": None},\n            {\"id\": 3.5},\n        ]\n        original = copy.deepcopy(rows)\n        expected = {\n            \"csv\": 'id,name\\n0,\"Zoë,\"\"猫\"\"\\nnext\"\\n,False\\n,\\n3.5,\\n',\n            \"json\": '[{\"id\":\"0\",\"name\":\"Zoë,\\\\\"猫\\\\\"\\\\nnext\"},'\n                    '{\"id\":\"\",\"name\":\"False\"},{\"id\":\"\",\"name\":\"\"},'\n                    '{\"id\":\"3.5\",\"name\":\"\"}]',\n        }\n        for format, wrapper in ((\"csv\", export_csv), (\"json\", export_json)):\n            for entry in (export_rows, export):\n                self.assertEqual(entry(iter(rows), format), expected[format])\n            self.assertEqual(wrapper(iter(rows)), expected[format])\n        self.assertEqual(rows, original)\n\n    def test_empty(self):\n        self.assertEqual(export_rows(iter([]), \"csv\"), \"id,name\\n\")\n        self.assertEqual(export_rows(iter([]), \"json\"), \"[]\")\n\n    def test_unsupported_format_does_not_consume_rows(self):\n        def rows():\n            self.fail(\"unsupported formats must not consume rows\")\n            yield {}\n\n        for entry in (export_rows, export):\n            with self.assertRaisesRegex(ValueError, \"unsupported format\"):\n                entry(rows(), \"xml\")\n\n    def test_wrappers_delegate(self):\n        for module, wrapper, format in (\n            (\"src.csv_exporter\", export_csv, \"csv\"),\n            (\"src.json_exporter\", export_json, \"json\"),\n        ):\n            rows = iter([{}])\n            with patch(module + \".export_rows\", return_value=\"result\") as shared:\n                self.assertEqual(wrapper(rows), \"result\")\n                shared.assert_called_once_with(rows, format)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nEOF\npython3 checks/public.py && python3 checks/exporter.py"
        },
