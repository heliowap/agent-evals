          "command": "python3 - <<'PY'\nfrom pathlib import Path\nPath('src/money.ts').write_text(\"\"\"export function formatAmount(cents: number): string {\n  const sign = cents < 0 ? '-' : '';\n  const absolute = Math.abs(cents);\n  return sign + Math.floor(absolute / 100) + '.' + String(absolute % 100).padStart(2, '0');\n}\n\"\"\")\nfor module, old in [('invoice', 'invoiceAmount'), ('report', 'reportAmount')]:\n    p = Path(f'src/{module}.ts')\n    p.write_text(p.read_text().replace(old, 'formatAmount').replace(\"from './formatAmount'\", \"from './money'\"))\n    Path(f'src/{old}.ts').unlink()\nPath('checks/public.cjs').write_text(\"\"\"const assert = require('node:assert/strict');\nconst { formatAmount } = require('../.build/money');\nconst { renderInvoice } = require('../.build/invoice');\nconst { renderReport } = require('../.build/report');\n\nconst cases = [\n  [0, '0.00'],\n  [-0, '0.00'],\n  [1, '0.01'],\n  [9, '0.09'],\n  [99, '0.99'],\n  [100, '1.00'],\n  [123, '1.23'],\n  [123456, '1234.56'],\n  [-1, '-0.01'],\n  [-9, '-0.09'],\n  [-99, '-0.99'],\n  [-100, '-1.00'],\n  [-123, '-1.23'],\n  [-123456, '-1234.56'],\n];\n\nfor (const [cents, expected] of cases) {\n  assert.equal(formatAmount(cents), expected);\n  assert.equal(renderInvoice('inv', cents), 'inv: $' + expected);\n}\n\nassert.equal(renderReport([]), '');\nassert.equal(\n  renderReport(cases.map(([cents], index) => ({ id: String(index), cents }))),\n  cases.map(([, expected], index) => index + ',' + expected).join('\\\\n'),\n);\nassert.equal(renderReport([{ id: 'a', cents: 0 }, { id: 'b', cents: -1 }]), 'a,0.00\\\\nb,-0.01');\n\"\"\")\nPY\ntsc -p tsconfig.json && node checks/public.cjs\nfind src -type f -maxdepth 1 -print; grep -R -nE 'invoiceAmount|reportAmount' src || true"
