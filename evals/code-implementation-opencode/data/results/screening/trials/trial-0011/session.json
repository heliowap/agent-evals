              "command": "cat > src/money.py <<'PY'\nimport re\nfrom decimal import Decimal\n\n\n_PLAIN_DECIMAL = re.compile(r\"[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)\")\n_MAX_AMOUNT = Decimal(\"1000000.00\")\n\n\ndef parse_amount(value):\n    if isinstance(value, bool):\n        raise ValueError(\"Amount must be a Decimal, integer, or plain decimal string\")\n    if isinstance(value, str):\n        if _PLAIN_DECIMAL.fullmatch(value) is None:\n            raise ValueError(\"Amount must be a plain decimal string\")\n        amount = Decimal(value)\n    elif isinstance(value, (Decimal, int)):\n        amount = Decimal(value)\n    else:\n        raise ValueError(\"Amount must be a Decimal, integer, or plain decimal string\")\n\n    if not amount.is_finite() or amount <= 0 or amount > _MAX_AMOUNT:\n        raise ValueError(\"Amount must be positive and at most 1000000.00\")\n\n    # Work on the coefficient rather than rounding or using context-sensitive\n    # decimal arithmetic. Only zero fractional cents may be discarded.\n    _, digits, exponent = amount.as_tuple()\n    if exponent < -2:\n        extra_digits = -2 - exponent\n        if extra_digits >= len(digits) or any(digits[-extra_digits:]):\n            raise ValueError(\"Amount must be exactly representable in cents\")\n        digits = digits[:-extra_digits]\n    elif exponent > -2:\n        digits += (0,) * (exponent + 2)\n\n    return Decimal((0, digits, -2))\n\n\ndef format_amount(value):\n    return format(value, \".2f\")\nPY\ncat > src/api.py <<'PY'\nfrom decimal import Decimal\n\nfrom .money import parse_amount, format_amount\n\n\ndef make_invoice(amounts):\n    # Each parsed coefficient is an integer number of cents. Integer addition\n    # keeps the total exact even when the caller uses a low decimal precision.\n    total_cents = 0\n    for item in amounts:\n        amount = parse_amount(item)\n        cents = 0\n        for digit in amount.as_tuple().digits:\n            cents = cents * 10 + digit\n        total_cents += cents\n        if total_cents > 100_000_000:\n            raise ValueError(\"Invoice total must be at most 1000000.00\")\n\n    digits = tuple(int(digit) for digit in str(total_cents))\n    total = Decimal((0, digits, -2))\n    return {\"total\": format_amount(total), \"count\": len(amounts)}\nPY\ncat > checks/test_amounts.py <<'PY'\nimport os\nimport sys\nimport unittest\nfrom decimal import Decimal, Inexact, Rounded, getcontext, localcontext\n\nsys.path.insert(0, os.getcwd())\n\nfrom src.api import make_invoice\nfrom src.money import format_amount, parse_amount\n\n\nclass AmountTests(unittest.TestCase):\n    def test_valid_amounts(self):\n        cases = [\n            (1, \"1.00\"),\n            (1000000, \"1000000.00\"),\n            (\"+12.34000\", \"12.34\"),\n            (\"0001.20\", \"1.20\"),\n            (\".01\", \"0.01\"),\n            (\"1.\", \"1.00\"),\n            (\"1000000.0000\", \"1000000.00\"),\n            (Decimal(\"1E+3\"), \"1000.00\"),\n            (Decimal(\"0.010000\"), \"0.01\"),\n            (\"1.\" + \"0\" * 5000, \"1.00\"),\n        ]\n        for value, expected in cases:\n            with self.subTest(value=value):\n                result = parse_amount(value)\n                self.assertIsInstance(result, Decimal)\n                self.assertEqual(result.as_tuple().exponent, -2)\n                self.assertEqual(format_amount(result), expected)\n\n    def test_invalid_amounts(self):\n        values = [\n            True, False, 1.0, float(\"nan\"), float(\"inf\"), None,\n            [], {}, b\"1.00\", object(), complex(1, 0),\n            \"\", \" \", \" 1\", \"1 \", \"1\\n\", \"1e2\", \"1E2\", \"1_0\",\n            \"NaN\", \"Infinity\", \"+\", \".\", \"1,00\", \"１２\", \"1.2.3\",\n            0, -1, 1000001, \"-0.00\", \"-1.00\", \"0.000\", \"0.001\",\n            \"1.001\", \"1.999\", \"1000000.01\", \"1000000.0001\",\n            Decimal(\"NaN\"), Decimal(\"sNaN\"), Decimal(\"Infinity\"),\n            Decimal(\"-Infinity\"), Decimal(\"-0\"), Decimal(\"0.0001\"),\n            Decimal(\"1.23001\"), Decimal(\"1E-999999\"),\n        ]\n        for value in values:\n            with self.subTest(value=value):\n                with self.assertRaises(ValueError):\n                    parse_amount(value)\n                with self.assertRaises(ValueError):\n                    make_invoice([value])\n\n    def test_invoices(self):\n        values = [\"1.2000\", Decimal(\"2.30\"), 3]\n        original = values.copy()\n        self.assertEqual(make_invoice(values), {\"total\": \"6.50\", \"count\": 3})\n        self.assertEqual(values, original)\n        self.assertEqual(make_invoice([]), {\"total\": \"0.00\", \"count\": 0})\n        self.assertEqual(\n            make_invoice([\"999999.99\", \".01\"]),\n            {\"total\": \"1000000.00\", \"count\": 2},\n        )\n        with self.assertRaises(ValueError):\n            make_invoice([\"1000000\", \".01\"])\n\n    def test_decimal_context_is_not_used_or_changed(self):\n        with localcontext() as context:\n            context.prec = 2\n            context.Emax = 2\n            context.Emin = -2\n            context.traps[Inexact] = True\n            context.traps[Rounded] = True\n            context.clear_flags()\n            before = context.copy()\n            self.assertEqual(format_amount(parse_amount(\"12345.67000\")), \"12345.67\")\n            self.assertEqual(\n                make_invoice([\"999999.99\", \".01\"]),\n                {\"total\": \"1000000.00\", \"count\": 2},\n            )\n            self.assertEqual(make_invoice([]), {\"total\": \"0.00\", \"count\": 0})\n            with self.assertRaises(ValueError):\n                parse_amount(Decimal(\"sNaN\"))\n            after = getcontext()\n            for attribute in (\n                \"prec\", \"rounding\", \"Emin\", \"Emax\", \"capitals\", \"clamp\",\n                \"flags\", \"traps\",\n            ):\n                self.assertEqual(getattr(after, attribute), getattr(before, attribute))\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nPY\npython3 checks/public.py\npython3 -m unittest discover -s checks -p 'test_*.py' -v",
