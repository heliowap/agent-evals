        "src/csv_exporter.py": "from .exporter import export_rows\n\n\ndef export_csv(rows):\n    return export_rows(rows, \"csv\")\n",
        "src/exporter.py": "import csv\nimport io\nimport json\n\n_FIELDS = (\"id\", \"name\")\n\n\ndef _normalize(rows):\n    for row in rows:\n        yield {k: \"\" if row.get(k) is None else str(row[k]) for k in _FIELDS}\n\n\ndef _to_csv(rows):\n    buffer = io.StringIO(newline=\"\")\n    writer = csv.writer(buffer, lineterminator=\"\\n\")\n    writer.writerow(_FIELDS)\n    for row in rows:\n        writer.writerow([row[k] for k in _FIELDS])\n    return buffer.getvalue()\n\n\ndef _to_json(rows):\n    return json.dumps(list(rows), ensure_ascii=False, separators=(\",\", \":\"))\n\n\n_SERIALIZERS = {\"csv\": _to_csv, \"json\": _to_json}\n\n\ndef export_rows(rows, format):\n    try:\n        serializer = _SERIALIZERS[format]\n    except (KeyError, TypeError):\n        raise ValueError(\"unsupported format\") from None\n    return serializer(_normalize(rows))\n",
