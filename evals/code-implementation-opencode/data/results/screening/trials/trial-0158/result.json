      "files": {
        "checks/public.cjs": "const assert = require('node:assert/strict');\n\n        const { DocumentRepository } = require('../.build/repository');\n        const { DocumentService } = require('../.build/service');\n        const repo = new DocumentRepository([{ id: 'one', tenant: 'a', owner: 'u', deleted: false, archived: false }]);\n        const service = new DocumentService(repo); const admin = { tenant: 'a', user: 'u', role: 'admin' };\n        service.archive(admin, 'one'); assert.equal(repo.documents[0].archived, true);\n        service.archive(admin, 'one'); assert.deepEqual(repo.audit, [{ actor: 'u', document: 'one' }]);\n        assert.throws(() => service.archive(admin, 'missing'), /not found/);\n\n// authorization checks\n{\n  const mk = () => new DocumentRepository([\n    { id: 'own', tenant: 'a', owner: 'e', deleted: false, archived: false },\n    { id: 'other', tenant: 'a', owner: 'x', deleted: false, archived: false },\n    { id: 'gone', tenant: 'a', owner: 'e', deleted: true, archived: false },\n    { id: 'foreign', tenant: 'b', owner: 'e', deleted: false, archived: false },\n    { id: 'done', tenant: 'a', owner: 'x', deleted: false, archived: true },\n  ]);\n  const r = mk(); const s = new DocumentService(r);\n  const editor = { tenant: 'a', user: 'e', role: 'editor' };\n  const viewer = { tenant: 'a', user: 'e', role: 'viewer' };\n  const adm = { tenant: 'a', user: 'adm', role: 'admin' };\n  const snap = () => JSON.stringify([r.documents, r.audit]);\n  const before = snap();\n  for (const id of ['gone', 'foreign', 'missing']) assert.throws(() => s.archive(adm, id), /^Error: not found$/);\n  assert.throws(() => s.archive(editor, 'other'), /^Error: forbidden$/);\n  assert.throws(() => s.archive(viewer, 'own'), /^Error: forbidden$/);\n  assert.throws(() => s.archive(viewer, 'done'), /^Error: forbidden$/);\n  assert.throws(() => s.archive(editor, 'done'), /^Error: forbidden$/);\n  assert.equal(snap(), before);\n  s.archive(editor, 'own');\n  s.archive(adm, 'other');\n  s.archive(adm, 'done');\n  assert.deepEqual(r.audit, [{ actor: 'e', document: 'own' }, { actor: 'adm', document: 'other' }]);\n}\n",
        "src/service.ts": "import { Actor, Document } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    // Visibility: active (not deleted) documents in the actor's tenant only.\n    const document = this.repository.documents.find(\n      row => row.id === id && row.tenant === actor.tenant && !row.deleted\n    );\n    if (!document) throw new Error('not found');\n    if (!this.canArchive(actor, document)) throw new Error('forbidden');\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n  private canArchive(actor: Actor, document: Document): boolean {\n    switch (actor.role) {\n      case 'admin': return true;\n      case 'editor': return document.owner === actor.user;\n      default: return false; // viewers and unknown roles are denied\n    }\n  }\n}\n"
