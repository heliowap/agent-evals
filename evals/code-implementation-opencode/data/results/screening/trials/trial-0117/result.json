    "scope": {
      "files": {
        "checks/public.cjs": "const assert = require('node:assert/strict');\n\n        const { DocumentRepository } = require('../.build/repository');\n        const { DocumentService } = require('../.build/service');\n        const repo = new DocumentRepository([{ id: 'one', tenant: 'a', owner: 'u', deleted: false, archived: false }]);\n        const service = new DocumentService(repo); const admin = { tenant: 'a', user: 'u', role: 'admin' };\n        service.archive(admin, 'one'); assert.equal(repo.documents[0].archived, true);\n        service.archive(admin, 'one'); assert.deepEqual(repo.audit, [{ actor: 'u', document: 'one' }]);\n        assert.throws(() => service.archive(admin, 'missing'), /not found/);\n\n// Authorization checks\n{\n  const mk = () => new DocumentRepository([\n    { id: 'own', tenant: 'a', owner: 'e', deleted: false, archived: false },\n    { id: 'other', tenant: 'a', owner: 'x', deleted: false, archived: false },\n    { id: 'gone', tenant: 'a', owner: 'e', deleted: true, archived: false },\n    { id: 'foreign', tenant: 'b', owner: 'e', deleted: false, archived: false },\n    { id: 'done', tenant: 'a', owner: 'x', deleted: false, archived: true },\n  ]);\n  const r = mk(); const s = new DocumentService(r);\n  const snap = () => JSON.stringify([r.documents, r.audit]);\n  const actor = (role, user = 'e', tenant = 'a') => ({ tenant, user, role });\n  const fails = (a, id, msg) => { const before = snap(); assert.throws(() => s.archive(a, id), new RegExp('^Error: ' + msg + '$')); assert.equal(snap(), before); };\n  for (const id of ['missing', 'gone', 'foreign']) { fails(actor('admin'), id, 'not found'); fails(actor('viewer'), id, 'not found'); }\n  fails(actor('viewer'), 'own', 'forbidden');\n  fails(actor('editor'), 'other', 'forbidden');\n  fails(actor('viewer', 'x'), 'done', 'forbidden');\n  fails(actor('editor', 'e'), 'done', 'forbidden');\n  s.archive(actor('editor'), 'own');\n  assert.deepEqual(r.audit, [{ actor: 'e', document: 'own' }]);\n  s.archive(actor('editor'), 'own');\n  assert.equal(r.audit.length, 1);\n  s.archive(actor('admin', 'adm'), 'other');\n  assert.equal(r.documents[1].archived, true);\n  assert.deepEqual(r.audit[1], { actor: 'adm', document: 'other' });\n  s.archive(actor('admin', 'adm'), 'done');\n  assert.equal(r.audit.length, 2);\n}\n",
        "src/service.ts": "import { Actor, Document } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    // Only active documents in the actor's tenant are visible.\n    if (!document || document.deleted || document.tenant !== actor.tenant) throw new Error('not found');\n    if (!this.canArchive(actor, document)) throw new Error('forbidden');\n    if (document.archived) return;\n    this.repository.archive(document, actor.user);\n  }\n  private canArchive(actor: Actor, document: Document): boolean {\n    switch (actor.role) {\n      case 'admin': return true;\n      case 'editor': return document.owner === actor.user;\n      default: return false; // viewers and any unknown role\n    }\n  }\n}\n"
