        "checks/public.py": "import os, sys\nsys.path.insert(0, os.getcwd())\nimport sqlite3\nfrom src.repository import initialize\nfrom src.service import get_document, list_documents\nc = sqlite3.connect(\":memory:\")\ninitialize(c)\nc.execute(\"INSERT INTO documents VALUES (1, 't', 'o', 'Title', 'Body', NULL)\")\nc.commit()\nassert get_document(c, \"t\", \"o\", 1) == {\"id\": 1, \"title\": \"Title\", \"body\": \"Body\"}\nassert list_documents(c, \"t\", \"o\") == [{\"id\": 1, \"title\": \"Title\", \"body\": \"Body\"}]\nassert get_document(c, \"t\", \"o\", 99) is None\n\n# Isolation, deletion, ordering and quoting\nc.executemany(\"INSERT INTO documents VALUES (?,?,?,?,?,?)\", [\n    (2, \"t\", \"o\", \"Second\", \"B2\", None),\n    (3, \"t2\", \"o\", \"OtherTenant\", \"x\", None),\n    (4, \"t\", \"o2\", \"OtherOwner\", \"x\", None),\n    (5, \"t\", \"o\", \"Deleted\", \"x\", \"2026-01-01\"),\n    (0, \"t\", \"o\", \"Zero\", \"B0\", None),\n    (6, \"t'; DROP TABLE documents;--\", \"o'x\", \"Q\", \"BQ\", None),\n])\nc.commit()\nfor bad in (3, 4, 5, 99):\n    assert get_document(c, \"t\", \"o\", bad) is None\nassert [d[\"id\"] for d in list_documents(c, \"t\", \"o\")] == [0, 1, 2]\nassert all(set(d) == {\"id\", \"title\", \"body\"} for d in list_documents(c, \"t\", \"o\"))\nassert get_document(c, \"t'; DROP TABLE documents;--\", \"o'x\", 6) == {\"id\": 6, \"title\": \"Q\", \"body\": \"BQ\"}\nassert get_document(c, \"t\", \"o'x\", 6) is None\nassert list_documents(c, \"t' OR '1'='1\", \"o\") == []\nassert list_documents(c, \"nobody\", \"o\") == []\n",
        "src/repository.py": "def initialize(connection):\n    connection.execute(\"CREATE TABLE documents(id INTEGER PRIMARY KEY, tenant TEXT, owner TEXT, title TEXT, body TEXT, deleted_at TEXT)\")\n    connection.commit()\n\ndef decode(row):\n    return {\"id\": row[0], \"title\": row[1], \"body\": row[2]}\n\ndef find(connection, tenant, owner, document_id):\n    row = connection.execute(\n        \"SELECT id, title, body FROM documents \"\n        \"WHERE id=? AND tenant=? AND owner=? AND deleted_at IS NULL\",\n        (document_id, tenant, owner),\n    ).fetchone()\n    return None if row is None else decode(row)\n\ndef listing(connection, tenant, owner):\n    rows = connection.execute(\n        \"SELECT id, title, body FROM documents \"\n        \"WHERE tenant=? AND owner=? AND deleted_at IS NULL ORDER BY id\",\n        (tenant, owner),\n    )\n    return [decode(row) for row in rows]\n",
        "src/service.py": "from .repository import find, listing\n\ndef get_document(connection, tenant, owner, document_id):\n    return find(connection, tenant, owner, document_id)\n\ndef list_documents(connection, tenant, owner):\n    return listing(connection, tenant, owner)\n"
