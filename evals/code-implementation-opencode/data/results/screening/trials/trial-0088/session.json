            "input": {
              "command": "cat > src/money.py <<'EOF'\nimport re\nfrom decimal import Decimal\n\n\nMAX_AMOUNT = Decimal(\"1000000.00\")\n_PLAIN_DECIMAL = re.compile(r\"[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)\")\n\n\ndef parse_amount(value):\n    \"\"\"Return a positive, bounded amount in exact cents, without rounding.\"\"\"\n    if isinstance(value, bool):\n        raise ValueError(\"Boolean amounts are not allowed\")\n    if isinstance(value, str):\n        if _PLAIN_DECIMAL.fullmatch(value) is None:\n            raise ValueError(\"Amount must be a plain decimal string\")\n        amount = Decimal(value)\n    elif isinstance(value, (Decimal, int)):\n        amount = Decimal(value)\n    else:\n        raise ValueError(\"Amount must be a Decimal, integer, or decimal string\")\n\n    if not amount.is_finite() or amount <= 0 or amount > MAX_AMOUNT:\n        raise ValueError(\"Amount must be positive and at most 1000000.00\")\n\n    # Work on the coefficient directly: Decimal arithmetic and quantize can\n    # round or fail under the caller's decimal context.\n    sign, digits, exponent = amount.as_tuple()\n    if exponent < -2:\n        excess = -2 - exponent\n        if excess >= len(digits) or any(digits[-excess:]):\n            raise ValueError(\"Amount must be exactly representable in cents\")\n        digits = digits[:-excess]\n    else:\n        digits += (0,) * (exponent + 2)\n    return Decimal((sign, digits, -2))\n\n\ndef format_amount(value):\n    return format(value, \".2f\")\nEOF\ncat > src/api.py <<'EOF'\nfrom decimal import Context, Decimal, localcontext\n\nfrom .money import MAX_AMOUNT, parse_amount, format_amount\n\n\ndef make_invoice(amounts):\n    # Each addition is bounded by twice MAX_AMOUNT, so this fresh context\n    # keeps every cent exact without modifying or depending on the caller's.\n    with localcontext(Context(prec=10)):\n        total = Decimal(\"0.00\")\n        for item in amounts:\n            total += parse_amount(item)\n            if total > MAX_AMOUNT:\n                raise ValueError(\"Invoice total must be at most 1000000.00\")\n    return {\"total\": format_amount(total), \"count\": len(amounts)}\nEOF\ncat > checks/regression.py <<'EOF'\nimport os\nimport sys\nimport unittest\nfrom decimal import Decimal, getcontext, localcontext\n\nsys.path.insert(0, os.getcwd())\nfrom src.api import make_invoice\nfrom src.money import format_amount, parse_amount\n\n\nclass AmountTests(unittest.TestCase):\n    def test_valid_amounts(self):\n        for value, expected in [\n            (1, \"1.00\"), (1000000, \"1000000.00\"),\n            (\"+12.50000\", \"12.50\"), (\"0001.20\", \"1.20\"),\n            (\".01\", \"0.01\"), (\"1.\", \"1.00\"),\n            (Decimal(\"1E+6\"), \"1000000.00\"),\n            (Decimal(\"0.010000\"), \"0.01\"),\n            (\"1000000.000000\", \"1000000.00\"),\n        ]:\n            with self.subTest(value=value):\n                result = parse_amount(value)\n                self.assertIsInstance(result, Decimal)\n                self.assertEqual(result.as_tuple().exponent, -2)\n                self.assertEqual(format_amount(result), expected)\n\n    def test_invalid_amounts(self):\n        for value in [\n            True, False, 1.0, float(\"nan\"), float(\"inf\"), None,\n            [], {}, b\"1.00\", object(),\n            \"\", \"+\", \".\", \" 1\", \"1 \", \"1\\n\", \"1e2\", \"1E-2\",\n            \"1_000\", \"1,000\", \"１２\", \"NaN\", \"Infinity\",\n            Decimal(\"NaN\"), Decimal(\"sNaN\"), Decimal(\"Infinity\"),\n            Decimal(\"-Infinity\"), 0, -1, \"-0.00\", \"-0.01\",\n            \"1000000.01\", 1000001, \"1000000.00001\",\n            \"0.001\", \"1.0010\", Decimal(\"1E-1000000\"),\n            Decimal(\"1E+1000000\"),\n        ]:\n            with self.subTest(value=value):\n                with self.assertRaises(ValueError):\n                    parse_amount(value)\n                with self.assertRaises(ValueError):\n                    make_invoice([value])\n\n    def test_invoices(self):\n        amounts = [\"1.2000\", Decimal(\"2.30\"), 3]\n        before = amounts[:]\n        self.assertEqual(make_invoice(amounts), {\"total\": \"6.50\", \"count\": 3})\n        self.assertEqual(amounts, before)\n        self.assertEqual(make_invoice([]), {\"total\": \"0.00\", \"count\": 0})\n        self.assertEqual(make_invoice([\"999999.99\", \".01\"]),\n                         {\"total\": \"1000000.00\", \"count\": 2})\n        for values in [[1000000, \".01\"], [\"999999.99\", \".02\"],\n                       [1000000, 1000000]]:\n            with self.assertRaises(ValueError):\n                make_invoice(values)\n\n    def test_context_independence(self):\n        with localcontext() as context:\n            context.prec = 1\n            context.Emax = 2\n            context.Emin = -2\n            context.clamp = 1\n            for signal in context.traps:\n                context.traps[signal] = True\n            before = context.copy()\n            self.assertEqual(parse_amount(\"123456.78000\"), Decimal(\"123456.78\"))\n            self.assertEqual(make_invoice([\"999999.99\", \".01\"]),\n                             {\"total\": \"1000000.00\", \"count\": 2})\n            with self.assertRaises(ValueError):\n                parse_amount(\"1.001\")\n            with self.assertRaises(ValueError):\n                make_invoice([1000000, 1])\n            after = getcontext()\n            for attribute in [\"prec\", \"rounding\", \"Emin\", \"Emax\", \"capitals\",\n                              \"clamp\", \"flags\", \"traps\"]:\n                self.assertEqual(getattr(after, attribute), getattr(before, attribute))\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nEOF\npython3 checks/public.py && python3 checks/regression.py"
