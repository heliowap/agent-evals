        "status": "completed",
        "input": {
          "command": "cd /workspace && cat > src/service.ts <<'EOF'\nimport { Actor } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    if (!document || document.deleted || document.tenant !== actor.tenant) throw new Error('not found');\n    const allowed =\n      actor.role === 'admin' || (actor.role === 'editor' && document.owner === actor.user);\n    if (!allowed) throw new Error('forbidden');\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n}\nEOF\ncat >> checks/public.cjs <<'EOF'\n\n{\n  const mk = () => new DocumentRepository([\n    { id: 'own', tenant: 'a', owner: 'e', deleted: false, archived: false },\n    { id: 'oth', tenant: 'a', owner: 'x', deleted: false, archived: false },\n    { id: 'del', tenant: 'a', owner: 'e', deleted: true, archived: false },\n    { id: 'for', tenant: 'b', owner: 'e', deleted: false, archived: false },\n    { id: 'done', tenant: 'a', owner: 'x', deleted: false, archived: true },\n  ]);\n  const r = mk(); const s = new DocumentService(r);\n  const ed = { tenant: 'a', user: 'e', role: 'editor' };\n  const vw = { tenant: 'a', user: 'e', role: 'viewer' };\n  const ad = { tenant: 'a', user: 'z', role: 'admin' };\n  for (const id of ['del', 'for', 'nope']) {\n    assert.throws(() => s.archive(ad, id), /not found/);\n    assert.throws(() => s.archive(vw, id), /not found/);\n  }\n  assert.throws(() => s.archive(ed, 'oth'), /forbidden/);\n  assert.throws(() => s.archive(vw, 'own'), /forbidden/);\n  assert.throws(() => s.archive(ed, 'done'), /forbidden/);\n  assert.equal(r.audit.length, 0);\n  assert.equal(r.documents.filter(d => d.archived).length, 1);\n  s.archive(ed, 'own'); s.archive(ad, 'oth'); s.archive(ad, 'done');\n  assert.deepEqual(r.audit, [{ actor: 'e', document: 'own' }, { actor: 'z', document: 'oth' }]);\n}\nEOF\ntsc -p tsconfig.json && node checks/public.cjs && echo ok"
