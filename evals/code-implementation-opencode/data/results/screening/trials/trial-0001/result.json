h, 1); assert.equal(receipts.length, 1);\\n          await assert.rejects(service.pay('shop', 'bad', 0), /invalid payment/);\\n        }\\n        module.exports = main();\\n{\\n  \\\"compilerOptions\\\": {\\n    \\\"target\\\": \\\"ES2022\\\",\\n    \\\"module\\\": \\\"CommonJS\\\",\\n    \\\"strict\\\": true,\\n    \\\"outDir\\\": \\\".build\\\",\\n    \\\"rootDir\\\": \\\"src\\\",\\n    \\\"lib\\\": [\\n      \\\"ES2022\\\",\\n      \\\"DOM\\\"\\n    ],\\n    \\\"forceConsistentCasingInFileNames\\\": true\\n  },\\n  \\\"include\\\": [\\n    \\\"src/**/*.ts\\\"\\n  ]\\n}\\n\",\"exit_code\":0,\"signal\":null,\"cancelled\":false,\"timeout\":false,\"truncated\":false}"
