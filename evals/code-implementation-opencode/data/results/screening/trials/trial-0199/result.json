") == [\n    {\"id\": 0, \"title\": \"Zero\", \"body\": \"z\"},\n    {\"id\": 1, \"title\": \"A\", \"body\": \"a\"},\n]\nassert all(set(d) == {\"id\", \"title\", \"body\"} for d in list_documents(c, \"t\", \"o\"))\nassert list_documents(c, \"t'x\", \"o'\\\" OR '1'='1\") == [{\"id\": 5, \"title\": \"Quoted\", \"body\": \"q\"}]\nassert get_document(c, \"t'x\", \"o'\\\" OR '1'='1\", 5)[\"id\"] == 5\nassert list_documents(c, \"t\", \"' OR '1'='1\") == []\nassert list_documents(c, \"nope\", \"o\") == []\nprint(\"ok\")\nEOF\npython3 checks/public.py && python3 checks/security.py"
