    "scope": {
      "files": {
        "checks/authorization.cjs": "const assert = require('node:assert/strict');\nconst { DocumentRepository } = require('../.build/repository');\nconst { DocumentService } = require('../.build/service');\n\n// Exercise visibility, permissions and idempotency independently of one another.\nfor (const role of ['admin', 'editor', 'viewer']) {\n  for (const owner of ['actor', 'other']) {\n    for (const tenant of ['local', 'foreign']) {\n      for (const deleted of [false, true]) {\n        for (const archived of [false, true]) {\n          const document = { id: 'target', tenant, owner, deleted, archived };\n          const unrelated = { id: 'unrelated', tenant: 'local', owner: 'other', deleted: false, archived: false };\n          const repo = new DocumentRepository([document, unrelated]);\n          repo.audit.push({ actor: 'previous', document: 'previous' });\n          const service = new DocumentService(repo);\n          const actor = { tenant: 'local', user: 'actor', role };\n          const beforeDocuments = structuredClone(repo.documents);\n          const beforeAudit = structuredClone(repo.audit);\n          const error = deleted || tenant !== actor.tenant\n            ? 'not found'\n            : role === 'viewer' || (role === 'editor' && owner !== actor.user)\n              ? 'forbidden'\n              : null;\n\n          if (error) {\n            assert.throws(() => service.archive(actor, 'target'), { message: error });\n            assert.deepEqual(repo.documents, beforeDocuments);\n            assert.deepEqual(repo.audit, beforeAudit);\n          } else {\n            service.archive(actor, 'target');\n            assert.deepEqual(repo.documents, [{ ...beforeDocuments[0], archived: true }, beforeDocuments[1]]);\n            const expectedAudit = archived\n              ? beforeAudit\n              : [...beforeAudit, { actor: actor.user, document: 'target' }];\n            assert.deepEqual(repo.audit, expectedAudit);\n            service.archive(actor, 'target');\n            assert.deepEqual(repo.documents, [{ ...beforeDocuments[0], archived: true }, beforeDocuments[1]]);\n            assert.deepEqual(repo.audit, expectedAudit);\n          }\n\n          const afterDocuments = structuredClone(repo.documents);\n          const afterAudit = structuredClone(repo.audit);\n          assert.throws(() => service.archive(actor, 'missing'), { message: 'not found' });\n          assert.deepEqual(repo.documents, afterDocuments);\n          assert.deepEqual(repo.audit, afterAudit);\n        }\n      }\n    }\n  }\n}\n",
        "src/service.ts": "import { Actor } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    if (!document || document.deleted || document.tenant !== actor.tenant) {\n      throw new Error('not found');\n    }\n    if (actor.role !== 'admin' && !(actor.role === 'editor' && document.owner === actor.user)) {\n      throw new Error('forbidden');\n    }\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n}\n"
      },
