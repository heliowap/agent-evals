        "checks/public.cjs": "const assert = require('node:assert/strict');\nconst { formatAmount } = require('../.build/money');\nconst { renderInvoice } = require('../.build/invoice');\nconst { renderReport } = require('../.build/report');\n\nconst cases = [\n  [123, '1.23'],\n  [0, '0.00'],\n  [-1, '-0.01'],\n  [1, '0.01'],\n  [99, '0.99'],\n  [100, '1.00'],\n  [-100, '-1.00'],\n  [-123, '-1.23'],\n  [1205, '12.05'],\n  [-1205, '-12.05'],\n];\nfor (const [cents, amount] of cases) {\n  assert.equal(formatAmount(cents), amount);\n  assert.equal(renderInvoice('inv', cents), 'inv: $' + amount);\n}\nassert.equal(renderReport([{ id: 'a', cents: 0 }, { id: 'b', cents: -1 }]), 'a,0.00\\nb,-0.01');\nassert.equal(\n  renderReport(cases.map(([cents], index) => ({ id: String(index), cents }))),\n  cases.map(([, amount], index) => index + ',' + amount).join('\\n'),\n);\nassert.equal(renderReport([]), '');\n",
        "src/invoice.ts": "import { formatAmount } from './money';\nexport function renderInvoice(id: string, cents: number): string { return id + ': $' + formatAmount(cents); }\n",
        "src/invoiceAmount.ts": null,
        "src/money.ts": "export function formatAmount(cents: number): string {\n  const sign = cents < 0 ? '-' : '';\n  const absolute = Math.abs(cents);\n  return sign + Math.floor(absolute / 100) + '.' + String(absolute % 100).padStart(2, '0');\n}\n",
        "src/report.ts": "import { formatAmount } from './money';\nexport function renderReport(rows: { id: string; cents: number }[]): string {\n  return rows.map(row => row.id + ',' + formatAmount(row.cents)).join('\\n');\n}\n",
        "src/reportAmount.ts": null
      },
