          "command": "cd /workspace && cat > src/money.ts <<'EOF'\nexport function formatAmount(cents: number): string {\n  const sign = cents < 0 ? '-' : '';\n  const absolute = Math.abs(cents);\n  return sign + Math.floor(absolute / 100) + '.' + String(absolute % 100).padStart(2, '0');\n}\nEOF\ncat > src/invoice.ts <<'EOF'\nimport { formatAmount } from './money';\nexport function renderInvoice(id: string, cents: number): string { return id + ': $' + formatAmount(cents); }\nEOF\ncat > src/report.ts <<'EOF'\nimport { formatAmount } from './money';\nexport function renderReport(rows: { id: string; cents: number }[]): string {\n  return rows.map(row => row.id + ',' + formatAmount(row.cents)).join('\\n');\n}\nEOF\nrm src/invoiceAmount.ts src/reportAmount.ts\ncat >> checks/public.cjs <<'EOF'\n\nconst { formatAmount } = require('../.build/money');\nfor (const [c, s] of [[0, '0.00'], [1, '0.01'], [-1, '-0.01'], [123, '1.23'], [-123, '-1.23'], [100, '1.00'], [-100, '-1.00'], [123456, '1234.56'], [-99, '-0.99']]) {\n  assert.equal(formatAmount(c), s);\n}\nassert.equal(renderInvoice('x', 0), 'x: $0.00');\nassert.equal(renderInvoice('x', -250), 'x: $-2.50');\nassert.equal(renderReport([{ id: 'z', cents: 500 }, { id: 'a', cents: -7 }, { id: 'm', cents: 0 }]), 'z,5.00\\na,-0.07\\nm,0.00');\nassert.equal(renderReport([]), '');\nEOF\ngrep -rn \"invoiceAmount\\|reportAmount\" src checks; rm -rf .build; tsc -p tsconfig.json && node checks/public.cjs && echo OK; ls .build"
