          "command": "cat > src/exporter.py <<'EOF'\nimport csv\nimport io\nimport json\n\n\n_FIELDS = (\"id\", \"name\")\n\n\ndef _normalize_rows(rows):\n    for row in rows:\n        yield {\n            key: \"\" if row.get(key) is None else str(row[key])\n            for key in _FIELDS\n        }\n\n\ndef export_rows(rows, format):\n    if format not in (\"csv\", \"json\"):\n        raise ValueError(\"unsupported format\")\n\n    clean = _normalize_rows(rows)\n    if format == \"json\":\n        return json.dumps(list(clean), ensure_ascii=False, separators=(\",\", \":\"))\n\n    buffer = io.StringIO(newline=\"\")\n    writer = csv.writer(buffer, lineterminator=\"\\n\")\n    writer.writerow(_FIELDS)\n    writer.writerows([row[key] for key in _FIELDS] for row in clean)\n    return buffer.getvalue()\nEOF\ncat > src/csv_exporter.py <<'EOF'\nfrom .exporter import export_rows\n\n\ndef export_csv(rows):\n    return export_rows(rows, \"csv\")\nEOF\ncat > src/json_exporter.py <<'EOF'\nfrom .exporter import export_rows\n\n\ndef export_json(rows):\n    return export_rows(rows, \"json\")\nEOF\ncat > checks/test_exporter.py <<'EOF'\nimport copy\nimport os\nimport sys\nimport unittest\nfrom unittest.mock import patch\n\nsys.path.insert(0, os.getcwd())\n\nfrom src.csv_exporter import export_csv\nfrom src.dispatcher import export\nfrom src.exporter import export_rows\nfrom src.json_exporter import export_json\n\n\nclass ExporterTests(unittest.TestCase):\n    def test_exact_output_and_unchanged_inputs(self):\n        rows = [\n            {\"id\": 1, \"name\": 'Zoë, \"A\"\\nB', \"ignored\": \"unused\"},\n            {\"id\": None},\n            {\"name\": False},\n            {\"id\": 0, \"name\": \"\"},\n        ]\n        original = copy.deepcopy(rows)\n        expected = {\n            \"csv\": 'id,name\\n1,\"Zoë, \"\"A\"\"\\nB\"\\n,\\n,False\\n0,\\n',\n            \"json\": '[{\"id\":\"1\",\"name\":\"Zoë, \\\\\"A\\\\\"\\\\nB\"},'\n                    '{\"id\":\"\",\"name\":\