      "files": {
        "checks/public.cjs": "const assert = require('node:assert/strict');\nconst { DocumentRepository } = require('../.build/repository');\nconst { DocumentService } = require('../.build/service');\n\nfor (const role of ['admin', 'editor', 'viewer']) {\n  for (const owner of ['actor', 'other']) {\n    for (const archived of [false, true]) {\n      for (const visibility of ['visible', 'missing', 'deleted', 'foreign']) {\n        const actor = { tenant: 'a', user: 'actor', role };\n        const repo = new DocumentRepository([\n          {\n            id: 'one',\n            tenant: visibility === 'foreign' ? 'b' : 'a',\n            owner,\n            deleted: visibility === 'deleted',\n            archived,\n          },\n          { id: 'untouched', tenant: 'a', owner: 'actor', deleted: false, archived: false },\n        ]);\n        repo.audit.push({ actor: 'previous', document: 'untouched' });\n        const service = new DocumentService(repo);\n        const id = visibility === 'missing' ? 'missing' : 'one';\n        const before = structuredClone({ documents: repo.documents, audit: repo.audit });\n        const context = `${role}, ${owner}, archived=${archived}, ${visibility}`;\n        const error = visibility !== 'visible'\n          ? 'not found'\n          : role === 'admin' || (role === 'editor' && owner === actor.user)\n            ? null\n            : 'forbidden';\n\n        if (error) {\n          assert.throws(() => service.archive(actor, id), new Error(error), context);\n          assert.deepEqual({ documents: repo.documents, audit: repo.audit }, before, context);\n        } else {\n          service.archive(actor, id);\n          const expected = structuredClone(before);\n          expected.documents[0].archived = true;\n          if (!archived) expected.audit.push({ actor: actor.user, document: id });\n          assert.deepEqual({ documents: repo.documents, audit: repo.audit }, expected, context);\n          service.archive(actor, id);\n          assert.deepEqual({ documents: repo.documents, audit: repo.audit }, expected, context);\n        }\n      }\n    }\n  }\n}\n",
        "src/service.ts": "import { Actor } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    if (!document || document.deleted || document.tenant !== actor.tenant) {\n      throw new Error('not found');\n    }\n    if (actor.role !== 'admin' && !(actor.role === 'editor' && document.owner === actor.user)) {\n      throw new Error('forbidden');\n    }\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n}\n"
