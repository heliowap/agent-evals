        "checks/public.py": "import os, sys\nsys.path.insert(0, os.getcwd())\nimport sqlite3\nfrom src.repository import initialize\nfrom src.service import get_document, list_documents\nc = sqlite3.connect(\":memory:\")\ninitialize(c)\nc.execute(\"INSERT INTO documents VALUES (1, 't', 'o', 'Title', 'Body', NULL)\")\nc.commit()\nassert get_document(c, \"t\", \"o\", 1) == {\"id\": 1, \"title\": \"Title\", \"body\": \"Body\"}\nassert list_documents(c, \"t\", \"o\") == [{\"id\": 1, \"title\": \"Title\", \"body\": \"Body\"}]\nassert get_document(c, \"t\", \"o\", 99) is None\n\n# access control checks\nc.execute(\"INSERT INTO documents VALUES (2, 't', 'o2', 'Other owner', 'x', NULL)\")\nc.execute(\"INSERT INTO documents VALUES (3, 't2', 'o', 'Other tenant', 'x', NULL)\")\nc.execute(\"INSERT INTO documents VALUES (4, 't', 'o', 'Deleted', 'x', '2026-01-01')\")\nc.execute(\"INSERT INTO documents VALUES (5, 't', 'o', 'Second', 'B2', NULL)\")\nc.execute(\"INSERT INTO documents VALUES (6, 't''x', 'o\\\"y', 'Quoted', 'q', NULL)\")\nc.commit()\nfor i in (2, 3, 4):\n    assert get_document(c, \"t\", \"o\", i) is None\nassert list_documents(c, \"t\", \"o\") == [\n    {\"id\": 1, \"title\": \"Title\", \"body\": \"Body\"},\n    {\"id\": 5, \"title\": \"Second\", \"body\": \"B2\"},\n]\nassert get_document(c, \"t'x\", 'o\"y', 6) == {\"id\": 6, \"title\": \"Quoted\", \"body\": \"q\"}\nassert list_documents(c, \"t' OR '1'='1\", \"o\") == []\nassert get_document(c, \"t\", \"o' OR '1'='1\", 1) is None\n",
        "src/repository.py": "def initialize(connection):\n    connection.execute(\"CREATE TABLE documents(id INTEGER PRIMARY KEY, tenant TEXT, owner TEXT, title TEXT, body TEXT, deleted_at TEXT)\")\n    connection.commit()\n\ndef decode(row):\n    return {\"id\": row[0], \"title\": row[1], \"body\": row[2]}\n\ndef find(connection, tenant, owner, document_id):\n    row = connection.execute(\n        \"SELECT id, title, body FROM documents \"\n        \"WHERE id=? AND tenant=? AND owner=? AND deleted_at IS NULL\",\n        (document_id, tenant, owner),\n    ).fetchone()\n    return None if row is None else decode(row)\n\ndef listing(connection, tenant, owner):\n    rows = connection.execute(\n        \"SELECT id, title, body FROM documents \"\n        \"WHERE tenant=? AND owner=? AND deleted_at IS NULL ORDER BY id\",\n        (tenant, owner),\n    )\n    return [decode(row) for row in rows]\n",
        "src/service.py": "from .repository import find, listing\n\ndef get_document(connection, tenant, owner, document_id):\n    return find(connection, tenant, owner, document_id)\n\ndef list_documents(connection, tenant, owner):\n    return listing(connection, tenant, owner)\n"
