      "state": {
        "status": "completed",
        "input": {
          "command": "cd /workspace && cat > src/repository.ts <<'EOF'\nimport { Order } from './types';\nconst cmp = (a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0);\nexport class OrderRepository {\n  constructor(private readonly rows: Order[]) {}\n  list(tenant: string, after?: { createdAt: string; id: string }): Order[] {\n    return this.rows\n      .filter(row => row.tenant === tenant)\n      .filter(row => !after || cmp(row.createdAt, after.createdAt) > 0 ||\n        (row.createdAt === after.createdAt && cmp(row.id, after.id) > 0))\n      .sort((a, b) => cmp(a.createdAt, b.createdAt) || cmp(a.id, b.id));\n  }\n}\nEOF\ncat > src/handler.ts <<'EOF'\nimport { OrderRepository } from './repository';\nimport { ListRequest, Page } from './types';\nexport class OrderHandler {\n  constructor(private readonly repository: OrderRepository) {}\n  list(request: ListRequest): Page {\n    if (!request.tenant || !Number.isInteger(request.limit) || request.limit < 1 || request.limit > 100) {\n      throw new Error('invalid request');\n    }\n    let after: { createdAt: string; id: string } | undefined;\n    if (request.cursor !== undefined) {\n      if (typeof request.cursor !== 'string') throw new Error('invalid request');\n      const parts = request.cursor.split('|');\n      if (parts.length !== 2 || !parts[0] || !parts[1]) throw new Error('invalid request');\n      after = { createdAt: parts[0], id: parts[1] };\n    }\n    const rows = this.repository.list(request.tenant, after);\n    const items = rows.slice(0, request.limit);\n    const last = items[items.length - 1];\n    const nextCursor = rows.length > items.length && last ? last.createdAt + '|' + last.id : null;\n    return { items, nextCursor };\n  }\n}\nEOF\ncat >> checks/public.cjs <<'EOF'\n\nconst h2 = new OrderHandler(new OrderRepository([\n  { id: 'b', tenant: 'a', createdAt: '1', total: 1 },\n  { id: 'a', tenant: 'a', createdAt: '1', total: 1 },\n  { id: 'z', tenant: 'o', createdAt: '1', total: 1 },\n  { id: 'c', tenant: 'a', createdAt: '2', total: 1 }\n]));\nconst p1 = h2.list({ tenant: 'a', limit: 2 });\nassert.deepEqual(p1.items.map(x => x.id), ['a', 'b']);\nassert.equal(p1.nextCursor, '1|b');\nconst p2 = h2.list({ tenant: 'a', limit: 2, cursor: p1.nextCursor });\nassert.deepEqual(p2.items.map(x => x.id), ['c']);\nassert.equal(p2.nextCursor, null);\nassert.deepEqual(h2.list({ tenant: 'a', limit: 5, cursor: '1|z' }).items.map(x => x.id), ['c']);\nfor (const cursor of ['', '1', '1|', '|a', '1|a|b']) assert.throws(() => h2.list({ tenant: 'a', limit: 1, cursor }), /invalid request/);\nEOF\ntsc -p tsconfig.json && node checks/public.cjs && echo ok"
