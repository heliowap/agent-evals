        "input": {
          "command": "cd /workspace; cat > src/repository.py <<'EOF'\ndef initialize(connection):\n    connection.execute(\"CREATE TABLE documents(id INTEGER PRIMARY KEY, tenant TEXT, owner TEXT, title TEXT, body TEXT, deleted_at TEXT)\")\n    connection.commit()\n\ndef decode(row):\n    return {\"id\": row[0], \"title\": row[1], \"body\": row[2]}\n\ndef find(connection, tenant, owner, document_id):\n    row = connection.execute(\n        \"SELECT id, title, body FROM documents\"\n        \" WHERE id=? AND tenant=? AND owner=? AND deleted_at IS NULL\",\n        (document_id, tenant, owner),\n    ).fetchone()\n    return None if row is None else decode(row)\n\ndef listing(connection, tenant, owner):\n    return [decode(row) for row in connection.execute(\n        \"SELECT id, title, body FROM documents\"\n        \" WHERE tenant=? AND owner=? AND deleted_at IS NULL ORDER BY id\",\n        (tenant, owner),\n    )]\nEOF\ncat > src/service.py <<'EOF'\nfrom .repository import find, listing\n\ndef get_document(connection, tenant, owner, document_id):\n    return find(connection, tenant, owner, document_id)\n\ndef list_documents(connection, tenant, owner):\n    return listing(connection, tenant, owner)\nEOF\ncat > checks/access.py <<'EOF'\nimport os, sys\nsys.path.insert(0, os.getcwd())\nimport sqlite3\nfrom src.repository import initialize\nfrom src.service import get_document, list_documents\n\nc = sqlite3.connect(\":memory:\")\ninitialize(c)\nrows = [\n    (1, \"t\", \"o\", \"A\", \"a\", None),\n    (2, \"t2\", \"o\", \"B\", \"b\", None),        # cross-tenant\n    (3, \"t\", \"o2\", \"C\", \"c\", None),        # cross-owner\n    (4, \"t\", \"o\", \"D\", \"d\", \"2026-01-01\"), # deleted\n    (5, \"t\", \"o\", \"E\", \"e\", None),\n    (6, \"q'x\", \"o'b\\\"\", \"Q\", \"q\", None),   # quoted names\n]\nc.executemany(\"INSERT INTO documents VALUES (?,?,?,?,?,?)\", rows)\nc.commit()\n\nassert get_document(c, \"t\", \"o\", 1) == {\"id\": 1, \"title\": \"A\", \"body\": \"a\"}\nfor i in (2, 3, 4, 99):\n    assert get_document(c, \"t\", \"o\", i) is None, i\nassert list_documents(c, \"t\", \"o\") == [\n    {\"id\": 1, \"title\": \"A\", \"body\": \"a\"},\n    {\"id\": 5, \"title\": \"E\", \"body\": \"e\"},\n]\nassert get_document(c, \"q'x\", \"o'b\\\"\", 6) == {\"id\": 6, \"title\": \"Q\", \"body\": \"q\"}\nassert list_documents(c, \"q'x\", \"o'b\\\"\") == [{\"id\": 6, \"title\": \"Q\", \"body\": \"q\"}]\nassert list_documents(c, \"t' OR '1'='1\", \"o\") == []\nassert get_document(c, \"t\", \"o' OR '1'='1\", 1) is None\nprint(\"ok\")\nEOF\npython3 checks/public.py && python3 checks/access.py"
