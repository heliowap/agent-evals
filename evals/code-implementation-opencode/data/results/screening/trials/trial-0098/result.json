        "checks/public.cjs": "const assert = require('node:assert/strict');\nconst { formatAmount } = require('../.build/money');\nconst { renderInvoice } = require('../.build/invoice');\nconst { renderReport } = require('../.build/report');\n\nconst cases = [\n  [0, '0.00'],\n  [-0, '0.00'],\n  [1, '0.01'],\n  [9, '0.09'],\n  [99, '0.99'],\n  [100, '1.00'],\n  [123, '1.23'],\n  [-1, '-0.01'],\n  [-99, '-0.99'],\n  [-100, '-1.00'],\n  [-123, '-1.23'],\n];\nfor (const [cents, expected] of cases) {\n  assert.equal(formatAmount(cents), expected);\n  assert.equal(renderInvoice('inv', cents), 'inv: $' + expected);\n  assert.equal(renderReport([{ id: 'row', cents }]), 'row,' + expected);\n}\nassert.equal(renderReport([]), '');\nassert.equal(\n  renderReport([{ id: 'z', cents: 123 }, { id: 'a', cents: 0 }, { id: 'b', cents: -1 }]),\n  'z,1.23\\na,0.00\\nb,-0.01'\n);\n",
        "src/invoice.ts": "import { formatAmount } from './money';\nexport function renderInvoice(id: string, cents: number): string { return id + ': $' + formatAmount(cents); }\n",
        "src/invoiceAmount.ts": null,
        "src/money.ts": "export function formatAmount(cents: number): string {\n  const sign = cents < 0 ? '-' : '';\n  const absolute = Math.abs(cents);\n  return sign + Math.floor(absolute / 100) + '.' + String(absolute % 100).padStart(2, '0');\n}\n",
        "src/report.ts": "import { formatAmount } from './money';\nexport function renderReport(rows: { id: string; cents: number }[]): string {\n  return rows.map(row => row.id + ',' + formatAmount(row.cents)).join('\\n');\n}\n",
        "src/reportAmount.ts": null
      },
