      "state": {
        "status": "completed",
        "input": {
          "command": "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/service.ts')\ns = p.read_text().replace(\"    if (!document) throw new Error('not found');\", \"    if (!document || document.deleted || document.tenant !== actor.tenant) {\\n      throw new Error('not found');\\n    }\\n    if (actor.role !== 'admin' && !(actor.role === 'editor' && document.owner === actor.user)) {\\n      throw new Error('forbidden');\\n    }\")\np.write_text(s)\nPY\ncat > checks/public.cjs <<'EOF'\nconst assert = require('node:assert/strict');\nconst { DocumentRepository } = require('../.build/repository');\nconst { DocumentService } = require('../.build/service');\n\nconst repo = new DocumentRepository([{ id: 'one', tenant: 'a', owner: 'u', deleted: false, archived: false }]);\nconst service = new DocumentService(repo);\nconst admin = { tenant: 'a', user: 'u', role: 'admin' };\nservice.archive(admin, 'one');\nassert.equal(repo.documents[0].archived, true);\nservice.archive(admin, 'one');\nassert.deepEqual(repo.audit, [{ actor: 'u', document: 'one' }]);\nassert.throws(() => service.archive(admin, 'missing'), /^Error: not found$/);\n\n// Cover visibility, ownership and permissions for both new and repeated archives.\nfor (const role of ['admin', 'editor', 'viewer']) {\n  for (const owner of ['u', 'other']) {\n    for (const archived of [false, true]) {\n      for (const visibility of ['visible', 'missing', 'deleted', 'foreign', 'foreign-deleted']) {\n        const document = {\n          id: 'target',\n          tenant: visibility.startsWith('foreign') ? 'b' : 'a',\n          owner,\n          deleted: visibility.includes('deleted'),\n          archived,\n        };\n        const untouched = { id: 'untouched', tenant: 'a', owner: 'u', deleted: false, archived: false };\n        const documents = visibility === 'missing' ? [untouched] : [document, untouched];\n        const repository = new DocumentRepository(documents);\n        repository.audit.push({ actor: 'previous', document: 'previous-document' });\n        const beforeDocuments = structuredClone(repository.documents);\n        const beforeAudit = structuredClone(repository.audit);\n        const actor = { tenant: 'a', user: 'u', role };\n        const subject = new DocumentService(repository);\n        const permitted = role === 'admin' || (role === 'editor' && owner === actor.user);\n        const error = visibility !== 'visible' ? 'not found' : permitted ? undefined : 'forbidden';\n\n        if (error) {\n          assert.throws(() => subject.archive(actor, 'target'), { name: 'Error', message: error });\n          assert.deepEqual(repository.documents, beforeDocuments);\n          assert.deepEqual(repository.audit, beforeAudit);\n        } else {\n          subject.archive(actor, 'target');\n          const expectedDocuments = structuredClone(beforeDocuments);\n          expectedDocuments[0].archived = true;\n          assert.deepEqual(repository.documents, expectedDocuments);\n          assert.deepEqual(repository.audit, archived ? beforeAudit : [\n            ...beforeAudit, { actor: actor.user, document: 'target' },\n          ]);\n          const afterAudit = structuredClone(repository.audit);\n          subject.archive(actor, 'target');\n          assert.deepEqual(repository.documents, expectedDocuments);\n          assert.deepEqual(repository.audit, afterAudit);\n        }\n      }\n    }\n  }\n}\nEOF\ntsc -p tsconfig.json && node checks/public.cjs"
