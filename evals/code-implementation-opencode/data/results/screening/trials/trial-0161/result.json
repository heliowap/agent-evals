        "checks/public.cjs": "const assert = require('node:assert/strict');\n\n        const { DocumentRepository } = require('../.build/repository');\n        const { DocumentService } = require('../.build/service');\n        const repo = new DocumentRepository([{ id: 'one', tenant: 'a', owner: 'u', deleted: false, archived: false }]);\n        const service = new DocumentService(repo); const admin = { tenant: 'a', user: 'u', role: 'admin' };\n        service.archive(admin, 'one'); assert.equal(repo.documents[0].archived, true);\n        service.archive(admin, 'one'); assert.deepEqual(repo.audit, [{ actor: 'u', document: 'one' }]);\n        assert.throws(() => service.archive(admin, 'missing'), /not found/);\n\n// authorization checks\n{\n  const mk = () => new DocumentRepository([\n    { id: 'own', tenant: 'a', owner: 'e', deleted: false, archived: false },\n    { id: 'other', tenant: 'a', owner: 'x', deleted: false, archived: false },\n    { id: 'del', tenant: 'a', owner: 'e', deleted: true, archived: false },\n    { id: 'foreign', tenant: 'b', owner: 'e', deleted: false, archived: false },\n  ]);\n  const r = mk(); const s = new DocumentService(r);\n  const editor = { tenant: 'a', user: 'e', role: 'editor' };\n  const viewer = { tenant: 'a', user: 'e', role: 'viewer' };\n  const adm = { tenant: 'a', user: 'u', role: 'admin' };\n  for (const id of ['del', 'foreign', 'missing']) assert.throws(() => s.archive(adm, id), /not found/);\n  assert.throws(() => s.archive(viewer, 'own'), /forbidden/);\n  assert.throws(() => s.archive(editor, 'other'), /forbidden/);\n  assert.equal(r.audit.length, 0); assert.ok(r.documents.every(d => !d.archived));\n  s.archive(editor, 'own'); assert.deepEqual(r.audit, [{ actor: 'e', document: 'own' }]);\n  assert.throws(() => s.archive(viewer, 'own'), /forbidden/);\n  s.archive(editor, 'own'); assert.equal(r.audit.length, 1);\n}\n",
        "src/service.ts": "import { Actor } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    if (!document || document.deleted || document.tenant !== actor.tenant) throw new Error('not found');\n    const allowed =\n      actor.role === 'admin' || (actor.role === 'editor' && document.owner === actor.user);\n    if (!allowed) throw new Error('forbidden');\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n}\n"
