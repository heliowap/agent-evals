      "files": {
        "checks/public.cjs": "const assert = require('node:assert/strict');\nconst { DocumentRepository } = require('../.build/repository');\nconst { DocumentService } = require('../.build/service');\n\n// Cover visibility and authorization independently, including archived documents.\nfor (const role of ['admin', 'editor', 'viewer']) {\n  for (const owner of ['u', 'other']) {\n    for (const archived of [false, true]) {\n      for (const visibility of ['visible', 'missing', 'deleted', 'foreign']) {\n        const document = {\n          id: 'one', tenant: visibility === 'foreign' ? 'b' : 'a', owner,\n          deleted: visibility === 'deleted', archived,\n        };\n        const unrelated = { id: 'two', tenant: 'b', owner: 'other', deleted: false, archived: false };\n        const repo = new DocumentRepository(visibility === 'missing' ? [unrelated] : [document, unrelated]);\n        repo.audit.push({ actor: 'previous', document: 'previous' });\n        const service = new DocumentService(repo);\n        const actor = { tenant: 'a', user: 'u', role };\n        const beforeDocuments = structuredClone(repo.documents);\n        const beforeAudit = structuredClone(repo.audit);\n        const error = visibility !== 'visible' ? 'not found'\n          : role === 'admin' || (role === 'editor' && owner === 'u') ? null : 'forbidden';\n\n        if (error) {\n          assert.throws(() => service.archive(actor, 'one'), { message: error });\n          assert.deepEqual(repo.documents, beforeDocuments);\n          assert.deepEqual(repo.audit, beforeAudit);\n        } else {\n          service.archive(actor, 'one');\n          assert.deepEqual(repo.documents, [{ ...document, archived: true }, unrelated]);\n          assert.deepEqual(repo.audit, archived ? beforeAudit\n            : [...beforeAudit, { actor: 'u', document: 'one' }]);\n          const afterDocuments = structuredClone(repo.documents);\n          const afterAudit = structuredClone(repo.audit);\n          service.archive(actor, 'one');\n          assert.deepEqual(repo.documents, afterDocuments);\n          assert.deepEqual(repo.audit, afterAudit);\n        }\n      }\n    }\n  }\n}\n",
        "src/service.ts": "import { Actor } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    if (!document || document.deleted || document.tenant !== actor.tenant) {\n      throw new Error('not found');\n    }\n    if (actor.role !== 'admin' && !(actor.role === 'editor' && document.owner === actor.user)) {\n      throw new Error('forbidden');\n    }\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n}\n"
