      "files": {
        "checks/public.cjs": "const assert = require('node:assert/strict');\nconst { DocumentRepository } = require('../.build/repository');\nconst { DocumentService } = require('../.build/service');\n\n// Cover visibility, permission, and idempotency independently for every role.\nfor (const role of ['admin', 'editor', 'viewer']) {\n  for (const tenant of ['a', 'b']) {\n    for (const owner of ['u', 'other']) {\n      for (const deleted of [false, true]) {\n        for (const archived of [false, true]) {\n          const document = { id: 'one', tenant, owner, deleted, archived };\n          const untouched = { id: 'two', tenant: 'a', owner: 'u', deleted: false, archived: false };\n          const repo = new DocumentRepository([document, untouched]);\n          repo.audit.push({ actor: 'previous', document: 'previous' });\n          const service = new DocumentService(repo);\n          const actor = { tenant: 'a', user: 'u', role };\n          const beforeDocuments = structuredClone(repo.documents);\n          const beforeAudit = structuredClone(repo.audit);\n          const error = deleted || tenant !== actor.tenant ? 'not found'\n            : role === 'viewer' || (role === 'editor' && owner !== actor.user) ? 'forbidden'\n            : null;\n\n          if (error) {\n            assert.throws(() => service.archive(actor, 'one'), { message: error });\n            assert.deepEqual(repo.documents, beforeDocuments);\n            assert.deepEqual(repo.audit, beforeAudit);\n          } else {\n            service.archive(actor, 'one');\n            assert.deepEqual(repo.documents, [{ ...beforeDocuments[0], archived: true }, beforeDocuments[1]]);\n            assert.deepEqual(repo.audit, archived ? beforeAudit\n              : [...beforeAudit, { actor: 'u', document: 'one' }]);\n            const afterAudit = structuredClone(repo.audit);\n            service.archive(actor, 'one');\n            assert.deepEqual(repo.audit, afterAudit);\n            assert.deepEqual(repo.documents, [{ ...beforeDocuments[0], archived: true }, beforeDocuments[1]]);\n          }\n\n          const currentDocuments = structuredClone(repo.documents);\n          const currentAudit = structuredClone(repo.audit);\n          assert.throws(() => service.archive(actor, 'missing'), { message: 'not found' });\n          assert.deepEqual(repo.documents, currentDocuments);\n          assert.deepEqual(repo.audit, currentAudit);\n        }\n      }\n    }\n  }\n}\n",
        "src/service.ts": "import { Actor } from './types';\nimport { DocumentRepository } from './repository';\nexport class DocumentService {\n  constructor(private readonly repository: DocumentRepository) {}\n  archive(actor: Actor, id: string): void {\n    const document = this.repository.find(id);\n    if (!document || document.deleted || document.tenant !== actor.tenant) {\n      throw new Error('not found');\n    }\n    if (actor.role !== 'admin' && !(actor.role === 'editor' && document.owner === actor.user)) {\n      throw new Error('forbidden');\n    }\n    if (!document.archived) this.repository.archive(document, actor.user);\n  }\n}\n"
