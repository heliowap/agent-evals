          "command": "cd /workspace && cat > src/money.ts <<'EOF'\nexport function formatAmount(cents: number): string {\n  const sign = cents < 0 ? '-' : '';\n  const absolute = Math.abs(cents);\n  return sign + Math.floor(absolute / 100) + '.' + String(absolute % 100).padStart(2, '0');\n}\nEOF\ncat > src/invoice.ts <<'EOF'\nimport { formatAmount } from './money';\nexport function renderInvoice(id: string, cents: number): string { return id + ': $' + formatAmount(cents); }\nEOF\ncat > src/report.ts <<'EOF'\nimport { formatAmount } from './money';\nexport function renderReport(rows: { id: string; cents: number }[]): string {\n  return rows.map(row => row.id + ',' + formatAmount(row.cents)).join('\\n');\n}\nEOF\nrm src/invoiceAmount.ts src/reportAmount.ts\ncat >> checks/public.cjs <<'EOF'\n\nconst { formatAmount } = require('../.build/money');\nassert.equal(formatAmount(0), '0.00');\nassert.equal(formatAmount(5), '0.05');\nassert.equal(formatAmount(123), '1.23');\nassert.equal(formatAmount(-1), '-0.01');\nassert.equal(formatAmount(-12345), '-123.45');\nassert.equal(renderInvoice('n', -250), 'n: $-2.50');\nassert.equal(renderReport([{ id: 'z', cents: 100 }, { id: 'y', cents: -100 }]), 'z,1.00\\ny,-1.00');\nEOF\nrm -rf .build; tsc -p tsconfig.json && node checks/public.cjs && echo OK; grep -rn \"invoiceAmount\\|reportAmount\" src"
