        "checks/security.py": "import os\nimport sqlite3\nimport sys\nimport unittest\n\nsys.path.insert(0, os.getcwd())\nfrom src.repository import initialize\nfrom src.service import get_document, list_documents\n\n\nclass DocumentAccessTests(unittest.TestCase):\n    def setUp(self):\n        self.connection = sqlite3.connect(\":memory:\")\n        self.addCleanup(self.connection.close)\n        initialize(self.connection)\n        self.connection.executemany(\n            \"INSERT INTO documents VALUES (?, ?, ?, ?, ?, ?)\",\n            [\n                (5, \"tenant\", \"owner\", \"Later\", \"Later body\", None),\n                (1, \"tenant\", \"owner\", \"First\", \"First body\", None),\n                (2, \"other\", \"owner\", \"Other tenant\", \"Body\", None),\n                (3, \"tenant\", \"other\", \"Other owner\", \"Body\", None),\n                (4, \"tenant\", \"owner\", \"Deleted\", \"Body\", \"2026-01-01\"),\n                (6, \"tenant' OR 1=1 --\", \"owner' OR 1=1 --\", \"Quoted\", \"Body\", None),\n                (7, \"tenant\", \"owner\", \"Also deleted\", \"Body\", \"\"),\n            ],\n        )\n\n    def test_get_requires_all_access_conditions(self):\n        self.assertEqual(\n            get_document(self.connection, \"tenant\", \"owner\", 1),\n            {\"id\": 1, \"title\": \"First\", \"body\": \"First body\"},\n        )\n        for document_id in (2, 3, 4, 6, 7, 99):\n            with self.subTest(document_id=document_id):\n                self.assertIsNone(get_document(self.connection, \"tenant\", \"owner\", document_id))\n        self.assertIsNone(get_document(self.connection, \"tenant\", \"owner\", \"1 OR 1=1\"))\n\n    def test_list_filters_and_preserves_result_shape_and_order(self):\n        self.assertEqual(\n            list_documents(self.connection, \"tenant\", \"owner\"),\n            [\n                {\"id\": 1, \"title\": \"First\", \"body\": \"First body\"},\n                {\"id\": 5, \"title\": \"Later\", \"body\": \"Later body\"},\n            ],\n        )\n        self.assertEqual(list_documents(self.connection, \"missing\", \"owner\"), [])\n\n    def test_quoted_names_are_bound_parameters(self):\n        tenant, owner = \"tenant' OR 1=1 --\", \"owner' OR 1=1 --\"\n        expected = {\"id\": 6, \"title\": \"Quoted\", \"body\": \"Body\"}\n        self.assertEqual(get_document(self.connection, tenant, owner, 6), expected)\n        self.assertEqual(list_documents(self.connection, tenant, owner), [expected])\n        self.assertIsNone(get_document(self.connection, tenant, owner, 1))\n        self.assertEqual(list_documents(self.connection, tenant, \"owner\"), [])\n        self.assertEqual(list_documents(self.connection, \"tenant\", owner), [])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n",
        "src/repository.py": "def initialize(connection):\n    connection.execute(\"CREATE TABLE documents(id INTEGER PRIMARY KEY, tenant TEXT, owner TEXT, title TEXT, body TEXT, deleted_at TEXT)\")\n    connection.commit()\n\ndef decode(row):\n    return {\"id\": row[0], \"title\": row[1], \"body\": row[2]}\n\ndef find(connection, tenant, owner, document_id):\n    row = connection.execute(\n        \"SELECT id, title, body FROM documents \"\n        \"WHERE id=? AND tenant=? AND owner=? AND deleted_at IS NULL\",\n        (document_id, tenant, owner),\n    ).fetchone()\n    return None if row is None else decode(row)\n\ndef listing(connection, tenant, owner):\n    rows = connection.execute(\n        \"SELECT id, title, body FROM documents \"\n        \"WHERE tenant=? AND owner=? AND deleted_at IS NULL ORDER BY id\",\n        (tenant, owner),\n    )\n    return [decode(row) for row in rows]\n",
        "src/service.py": "from .repository import find, listing\n\ndef get_document(connection, tenant, owner, document_id):\n    return find(connection, tenant, owner, document_id)\n\ndef list_documents(connection, tenant, owner):\n    return listing(connection, tenant, owner)\n"
