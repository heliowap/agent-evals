ortAmount(cents: number): string {\\n./src/report.ts:1:import { reportAmount } from './reportAmount';\\n./src/report.ts:3:  return rows.map(row => row.id + ',' + reportAmount(row.cents)).join('\\\\n');\\n./src/invoiceAmount.ts:1:export function invoiceAmount(cents: number): string {\\n\",\"exit_code\":0,\"signal\":null,\"cancelled\":false,\"timeout\":false,\"truncated\":false}"
