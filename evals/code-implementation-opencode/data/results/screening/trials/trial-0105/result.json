        "src/csv_exporter.py": "from .exporter import export_rows\n\n\ndef export_csv(rows):\n    return export_rows(rows, \"csv\")\n",
        "src/exporter.py": "\"\"\"Shared export pipeline used by the CSV and JSON exporters.\"\"\"\nimport csv\nimport io\nimport json\n\nFIELDS = (\"id\", \"name\")\n\n\ndef _normalize(rows):\n    \"\"\"Yield new dicts with only FIELDS; None/missing -> '', others str().\n\n    Consumes ``rows`` exactly once, preserves order and never mutates input.\n    \"\"\"\n    for row in rows:\n        clean = {}\n        for key in FIELDS:\n            value = row.get(key)\n            clean[key] = \"\" if value is None else str(value)\n        yield clean\n\n\ndef _to_csv(records):\n    buffer = io.StringIO(newline=\"\")\n    writer = csv.writer(buffer, lineterminator=\"\\n\")\n    writer.writerow(FIELDS)\n    for record in records:\n        writer.writerow([record[key] for key in FIELDS])\n    return buffer.getvalue()\n\n\ndef _to_json(records):\n    return json.dumps(list(records), ensure_ascii=False, separators=(\",\", \":\"))\n\n\n_SERIALIZERS = {\"csv\": _to_csv, \"json\": _to_json}\n\n\ndef export_rows(rows, format):\n    \"\"\"Serialize ``rows`` to ``format`` ('csv' or 'json').\"\"\"\n    try:\n        serializer = _SERIALIZERS[format]\n    except (KeyError, TypeError):\n        raise ValueError(\"unsupported format\") from None\n    return serializer(_normalize(rows))\n",
        "src/json_exporter.py": "from .exporter import export_rows\n\n\ndef export_json(rows):\n    return export_rows(rows, \"json\")\n"
