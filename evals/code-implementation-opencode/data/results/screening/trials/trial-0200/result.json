{\"id\": 10, \"title\": \"Q'\", \"body\": 'B\"'}]\nassert list_documents(c, \"ten'ant; DROP TABLE documents --\", \"x\") == []\nassert c.execute(\"SELECT COUNT(*) FROM documents\").fetchone()[0] == 9\n\n# no deletion metadata leaks into results\nfor doc in list_documents(c, \"t1\", \"o1\"):\n    assert set(doc) == {\"id\", \"title\", \"body\"}\nprint(\"security checks passed\")\n",
        "src/repository.py": "def initialize(connection):\n    connection.execute(\"CREATE TABLE documents(id INTEGER PRIMARY KEY, tenant TEXT, owner TEXT, title TEXT, body TEXT, deleted_at TEXT)\")\n    connection.commit()\n\ndef decode(row):\n    return {\"id\": row[0], \"title\": row[1], \"body\": row[2]}\n\ndef find(connection, tenant, owner, document_id):\n    row = connection.execute(\n        \"SELECT id, title, body FROM documents\"\n        \" WHERE id=? AND tenant=? AND owner=? AND deleted_at IS NULL\",\n        (document_id, tenant, owner),\n    ).fetchone()\n    return None if row is None else decode(row)\n\ndef listing(connection, tenant, owner):\n    return [\n        decode(row)\n        for row in connection.execute(\n            \"SELECT id, title, body FROM documents\"\n            \" WHERE tenant=? AND owner=? AND deleted_at IS NULL ORDER BY id\",\n            (tenant, owner),\n        )\n    ]\n",
