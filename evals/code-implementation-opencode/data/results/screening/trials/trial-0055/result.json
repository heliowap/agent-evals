        "checks/exporter_checks.py": "import os, sys\nsys.path.insert(0, os.getcwd())\nfrom src.exporter import export_rows\nfrom src.csv_exporter import export_csv\nfrom src.json_exporter import export_json\nfrom src.dispatcher import export\n\nrows = [{\"id\": 1, \"name\": \"Zoë, \\\"Z\\\"\", \"extra\": 9}, {\"id\": None}, {\"name\": 5}]\norig = [dict(r) for r in rows]\nassert export_csv(rows) == 'id,name\\n1,\"Zoë, \"\"Z\"\"\"\\n,\\n,5\\n'\nassert export_json(rows) == '[{\"id\":\"1\",\"name\":\"Zoë, \\\\\"Z\\\\\"\"},{\"id\":\"\",\"name\":\"\"},{\"id\":\"\",\"name\":\"5\"}]'\nassert rows == orig\nassert export_csv(iter(rows)) == export_rows(rows, \"csv\")\nassert export_json(r for r in rows) == export_rows(rows, \"json\")\nassert export_rows([], \"csv\") == \"id,name\\n\" and export_rows([], \"json\") == \"[]\"\nfor f in (\"xml\", None, \"CSV\", []):\n    try:\n        export_rows([], f)\n    except ValueError:\n        pass\n    else:\n        raise AssertionError(f)\n    try:\n        export([], f)\n    except ValueError:\n        pass\n    else:\n        raise AssertionError(f)\nprint(\"ok\")\n",
        "src/csv_exporter.py": "from .exporter import export_rows\n\n\ndef export_csv(rows):\n    return export_rows(rows, \"csv\")\n",
