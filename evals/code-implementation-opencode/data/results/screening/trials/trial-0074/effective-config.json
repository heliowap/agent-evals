{
  "model": {
    "providerID": "cli_proxy",
    "model": "cpa-claude-opus-5-5",
    "variant": "medium"
  },
  "default_agent": "implementer",
  "update": "disable",
  "share": "disabled",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "terminal",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "implementer": {
      "system": "Implement the requested change in the project. Use the terminal tool to explore and edit files and run the public checks. The Linux project is at /workspace. Keep changes within the requested scope. Preserve existing behavior. You receive one task; complete it autonomously and summarize the resulting change and verification. Do not use external services.",
      "mode": "all",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "terminal",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "title": {
      "disabled": true
    },
    "summary": {
      "disabled": true
    }
  },
  "formatter": false,
  "lsp": false,
  "mcp": {},
  "skills": [],
  "instructions": [],
  "plugins": [
    "-opencode.skill",
    "/tmp/folders/T/private-runtime-qbrou_2x/observer",
    "/tmp/folders/T/private-runtime-qbrou_2x/terminal"
  ],
  "warming": false,
  "providers": {
    "cli_proxy": {
      "canonical": "anthropic",
      "name": "CLI Proxy",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1"
      },
      "models": {
        "cpa-claude-opus-5-5": {
          "modelID": "claude-opus-5-5",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 32768
          }
        }
      }
    }
  }
}
