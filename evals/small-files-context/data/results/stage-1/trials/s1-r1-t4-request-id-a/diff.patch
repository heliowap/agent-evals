diff --git a/test/test_request_id.py b/test/test_request_id.py
new file mode 100644
index 0000000..369279f
--- /dev/null
+++ b/test/test_request_id.py
@@ -0,0 +1,142 @@
+# -*- coding: utf-8 -*-
+import re
+import wsgiref.util
+import bottle
+from .tools import ServerTestBase
+
+HEX32 = re.compile(r'[0-9a-f]{32}\Z')
+
+
+class TestRequestId(ServerTestBase):
+    ''' Tests for the opt-in request ID (config 'request_id.header') '''
+
+    def setUp(self):
+        super(TestRequestId, self).setUp()
+        self.app.config['request_id.header'] = 'X-Request-ID'
+
+    def test_generated_id(self):
+        """ Request ID: a new 32 hex char ID is generated if the client sends none """
+        @bottle.route('/')
+        def test(): return bottle.request.request_id
+        result = self.urlopen('/')
+        self.assertTrue(HEX32.match(result['body'].decode('ascii')))
+        self.assertEqual(result['body'].decode('ascii'), result['header']['X-Request-Id'])
+
+    def test_same_value_per_read(self):
+        """ Request ID: reading request.request_id twice gives the same value """
+        @bottle.route('/')
+        def test():
+            return bottle.request.request_id + ' ' + bottle.request.request_id
+        first, second = self.urlopen('/')['body'].decode('ascii').split()
+        self.assertEqual(first, second)
+
+    def test_new_id_per_request(self):
+        """ Request ID: each request gets its own generated ID """
+        @bottle.route('/')
+        def test(): return bottle.request.request_id
+        self.assertNotEqual(self.urlopen('/')['body'], self.urlopen('/')['body'])
+
+    def test_client_id_used(self):
+        """ Request ID: the value of the incoming header is used """
+        @bottle.route('/')
+        def test(): return bottle.request.request_id
+        result = self.urlopen('/', env={'HTTP_X_REQUEST_ID': 'client-42'})
+        self.assertEqual(b'client-42', result['body'])
+        self.assertEqual('client-42', result['header']['X-Request-Id'])
+
+    def test_empty_client_id_replaced(self):
+        """ Request ID: an empty incoming header is replaced by a generated ID """
+        @bottle.route('/')
+        def test(): return bottle.request.request_id
+        result = self.urlopen('/', env={'HTTP_X_REQUEST_ID': ''})
+        self.assertTrue(HEX32.match(result['body'].decode('ascii')))
+
+    def test_invalid_client_id_replaced(self):
+        """ Request ID: an incoming header with control characters is not echoed """
+        @bottle.route('/')
+        def test(): return bottle.request.request_id
+        result = self.urlopen('/', env={'HTTP_X_REQUEST_ID': 'a\r\nSet-Cookie: x=y'})
+        self.assertTrue(HEX32.match(result['body'].decode('ascii')))
+        self.assertNotIn('Set-Cookie', result['header'])
+
+    def test_every_response_has_id(self):
+        """ Request ID: normal, error and short-circuit responses carry the ID """
+        @bottle.route('/ok')
+        def ok(): return 'ok'
+        @bottle.route('/crash')
+        def crash(): raise ValueError('boom')
+        @bottle.route('/abort')
+        def aborted(): bottle.abort(403, 'no')
+        @bottle.route('/redirect')
+        def redirected(): bottle.redirect('/ok')
+        @bottle.route('/raise')
+        def raised(): raise bottle.HTTPResponse('made', 201, {'X-Other': 'yes'})
+        @bottle.route('/return')
+        def returned(): return bottle.HTTPResponse('made', 202)
+        @bottle.route('/empty')
+        def empty(): bottle.response.status = 204; return ''
+        expected = [('/ok', 200), ('/missing', 404), ('/crash', 500),
+                    ('/abort', 403), ('/redirect', 302), ('/raise', 201),
+                    ('/return', 202), ('/empty', 204)]
+        for path, code in expected:
+            result = self.urlopen(path, env={'HTTP_X_REQUEST_ID': 'req-1'})
+            self.assertEqual(code, result['code'], path)
+            self.assertEqual('req-1', result['header'].get('X-Request-Id'), path)
+
+    def test_head_has_id(self):
+        """ Request ID: HEAD responses carry the ID """
+        @bottle.route('/')
+        def test(): return 'test'
+        result = self.urlopen('/', method='HEAD', env={'HTTP_X_REQUEST_ID': 'req-1'})
+        self.assertEqual('req-1', result['header'].get('X-Request-Id'))
+
+    def test_error_handler_has_id(self):
+        """ Request ID: custom error handler output carries the ID """
+        @self.app.error(404)
+        def custom(err): return 'custom'
+        result = self.urlopen('/missing', env={'HTTP_X_REQUEST_ID': 'req-1'})
+        self.assertEqual(404, result['code'])
+        self.assertEqual(b'custom', result['body'])
+        self.assertEqual('req-1', result['header'].get('X-Request-Id'))
+
+    def test_handler_cannot_override_id(self):
+        """ Request ID: a header set by the handler does not replace the ID """
+        @bottle.route('/')
+        def test():
+            bottle.response.set_header('X-Request-ID', 'other')
+            return 'test'
+        result = self.urlopen('/', env={'HTTP_X_REQUEST_ID': 'req-1'})
+        self.assertEqual('req-1', result['header'].get('X-Request-Id'))
+
+    def test_critical_error_has_id(self):
+        """ Request ID: the critical error fallback response carries the ID """
+        @bottle.route('/')
+        def test(): return 'test'
+        calls = []
+        def start_response(status, headers, exc_info=None):
+            calls.append((status, headers))
+            if len(calls) == 1:
+                raise RuntimeError('start_response failed')
+        env = {'REQUEST_METHOD': 'GET', 'PATH_INFO': '/',
+               'HTTP_X_REQUEST_ID': 'req-1'}
+        wsgiref.util.setup_testing_defaults(env)
+        self.app(env, start_response)
+        status, headers = calls[-1]
+        self.assertTrue(status.startswith('500'))
+        self.assertIn(('X-Request-ID', 'req-1'), headers)
+
+
+class TestRequestIdDisabled(ServerTestBase):
+    ''' Without 'request_id.header' nothing changes '''
+
+    def test_no_id(self):
+        """ Request ID: disabled by default, no header and no ID """
+        @bottle.route('/')
+        def test(): return repr(bottle.request.request_id)
+        @bottle.route('/crash')
+        def crash(): raise ValueError('boom')
+        result = self.urlopen('/', env={'HTTP_X_REQUEST_ID': 'req-1'})
+        self.assertEqual(b'None', result['body'])
+        self.assertNotIn('X-Request-Id', result['header'])
+        for path in ('/missing', '/crash'):
+            self.assertNotIn('X-Request-Id', self.urlopen(path)['header'])
