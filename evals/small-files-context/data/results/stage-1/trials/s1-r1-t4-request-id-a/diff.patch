+def _request_id(environ, header):
+    """ Return the request ID for a WSGI environ, or None if no ``header`` is
+        configured. The ID is the value of that request header if it is present
+        and valid, or a new random 32-character hex string. It is generated once
+        and cached in the environ, so every call during a request returns the
+        same value. """
+    if not header: return None
+    key = 'bottle.request.request_id'
+    if key not in environ:
+        value = WSGIHeaderDict(environ).get(header)
+        if not value or any(c in value for c in '\r\n\0'):
+            value = secrets.token_hex(16)
+        environ[key] = value
+    return environ[key]
+
