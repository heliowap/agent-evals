@@ -454,6 +462,20 @@ class BaseRequest:
             raise AttributeError("Attribute not defined: %s" % name)
 
 
+def _request_id(environ, app):
+    """ Return the request ID of a WSGI environ. It is created on first use and
+        stored in the environ, so later calls for the same request return the
+        same value. See :attr:`BaseRequest.request_id`. """
+    if 'bottle.request.id' not in environ:
+        header = app.config.get('request_id.header') if app else None
+        value = WSGIHeaderDict(environ).get(header) if header else None
+        # Values with control characters cannot be sent back as a header.
+        if not value or not value.isprintable():
+            value = os.urandom(16).hex()
+        environ['bottle.request.id'] = value
+    return environ['bottle.request.id']
+
