+    @property
+    def request_id(self):
+        """ The ID of this request. If the app config ``request_id.header``
+            names a header and the request has it, the header value is used.
+            Otherwise a new random 32-character hex string is generated. The
+            same ID is returned for the rest of the request. """
+        return _request_id(self.environ, self.environ.get('bottle.app'))
