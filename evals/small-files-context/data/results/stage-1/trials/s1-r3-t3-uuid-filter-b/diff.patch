+    def test_uuid_route(self):
+        """ WSGI: uuid wildcard passes uuid.UUID objects and 404s on non-UUIDs """
+        u = '123e4567-e89b-12d3-a456-426614174000'
+        @bottle.route('/item/<id:uuid>', name='uuid_item')
+        def item(id): return type(id).__name__ + ' ' + str(id)
+        self.assertBody('UUID ' + u, '/item/' + u)
+        self.assertStatus(404, '/item/not-a-uuid')
+        bottle.request.environ['SCRIPT_NAME'] = ''
+        self.assertEqual('/item/' + u, bottle.app().get_url('uuid_item', id=uuid.UUID(u)))
