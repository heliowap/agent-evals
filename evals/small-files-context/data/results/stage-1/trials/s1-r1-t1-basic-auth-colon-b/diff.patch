 # -*- coding: utf-8 -*-
+import base64
+import unittest
 import bottle
 from .tools import ServerTestBase
 
+class TestParseAuth(unittest.TestCase):
+
+    def basic(self, credentials):
+        return 'Basic ' + base64.b64encode(credentials.encode('utf8')).decode('ascii')
+
+    def test_simple(self):
+        self.assertEqual(bottle.parse_auth(self.basic('user:pass')), ('user', 'pass'))
+
+    def test_password_with_colon(self):
+        self.assertEqual(bottle.parse_auth(self.basic('user:pa:ss')), ('user', 'pa:ss'))
+
+    def test_password_with_colon_request_auth(self):
+        environ = {'HTTP_AUTHORIZATION': self.basic('user:pa:ss:')}
+        self.assertEqual(bottle.LocalRequest(environ).auth, ('user', 'pa:ss:'))
+
+    def test_no_colon(self):
+        self.assertIsNone(bottle.parse_auth(self.basic('userpass')))
+
+    def test_not_basic(self):
+        self.assertIsNone(bottle.parse_auth('Digest user:pass'))
+
+
 class TestBasicAuth(ServerTestBase):
 
