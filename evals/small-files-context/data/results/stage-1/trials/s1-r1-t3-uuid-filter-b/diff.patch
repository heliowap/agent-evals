+    def test_uuid_route(self):
+        """ WSGI: uuid filter passes uuid.UUID to the callback and builds URLs """
+        @bottle.route('/item/<id:uuid>', name='uuidnamed')
+        def item(id):
+            return '%s:%s' % (type(id).__name__, id)
+        u = '12345678-1234-5678-1234-567812345678'
+        self.assertBody('UUID:' + u, '/item/' + u)
+        self.assertStatus(404, '/item/not-a-uuid')
+        bottle.request.environ['SCRIPT_NAME'] = ''
+        self.assertEqual('/item/' + u, bottle.app().get_url('uuidnamed', id=uuid.UUID(u)))
+
