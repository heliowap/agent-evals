+    def test_uuid_filter(self):
+        """ WSGI: uuid filter passes UUID objects to callbacks and builds URLs """
+        uid = uuid.UUID('12345678-1234-5678-9abc-def012345678')
+        @bottle.route('/item/<id:uuid>', name='item')
+        def item(id):
+            return type(id).__name__ + ':' + str(id)
+        self.assertBody('UUID:' + str(uid), '/item/' + str(uid))
+        self.assertBody('UUID:' + str(uid), '/item/' + str(uid).upper())
+        self.assertStatus(404, '/item/not-a-uuid')
+        bottle.request.environ['SCRIPT_NAME'] = ''
+        self.assertEqual('/item/' + str(uid), bottle.app().get_url('item', id=uid))
+
