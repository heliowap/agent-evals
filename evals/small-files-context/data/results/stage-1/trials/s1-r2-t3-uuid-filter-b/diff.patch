@@ -74,6 +75,40 @@ class TestRouter(unittest.TestCase):
         self.assertRaises(bottle.HTTPError, self.match, '/object/')
         self.assertRaises(bottle.HTTPError, self.match, '/object/.')
 
+    def testUUIDFilter(self):
+        uid = '12345678-1234-5678-9abc-def012345678'
+        self.assertMatches('/item/<id:uuid>', '/item/' + uid, id=uuid.UUID(uid))
+        self.assertMatches('/item/<id:uuid>', '/item/' + uid.upper(), id=uuid.UUID(uid))
+        self.assertIsInstance(self.match('/item/' + uid)[1]['id'], uuid.UUID)
+
+    def testUUIDFilterNotFound(self):
+        uid = '12345678-1234-5678-9abc-def012345678'
+        self.add('/item/<id:uuid>', 'handler')
+        for path in ['/item/', '/item/abc', '/item/' + uid[:-1], '/item/' + uid + '0',
+                     '/item/' + uid.replace('-', ''), '/item/{' + uid + '}',
+                     '/item/urn:uuid:' + uid, '/item/1234567-81234-5678-9abc-def012345678',
+                     '/item/12345678-1234-5678-9abc-def01234567g', '/item/ ' + uid,
+                     '/item/' + uid + '/more']:
+            with self.assertRaises(bottle.HTTPError) as e:
+                self.match(path)
+            self.assertEqual(404, e.exception.status_code, path)
+
+    def testAnonUUIDFilter(self):
+        self.add('/anon/<:uuid>', 'handler')
+        self.assertEqual('handler', self.match('/anon/12345678-1234-5678-9abc-def012345678')[0])
+        self.assertRaises(bottle.HTTPError, self.match, '/anon/nope')
+
+    def testBuildUUIDFilter(self):
+        add, build = self.add, self.r.build
+        add('/item/<id:uuid>', 'handler', name='uuidroute')
+        uid = uuid.UUID('12345678-1234-5678-9ABC-DEF012345678')
+        expected = '/item/12345678-1234-5678-9abc-def012345678'
+
+        self.assertEqual(expected, build('uuidroute', id=uid))
+        self.assertEqual(expected, build('uuidroute', id=str(uid).upper()))
+        self.assertEqual(expected, build('uuidroute', id=uid.hex))
+        self.assertRaises(ValueError, build, 'uuidroute', id='not-a-uuid')
+
     def testPathFilter(self):
