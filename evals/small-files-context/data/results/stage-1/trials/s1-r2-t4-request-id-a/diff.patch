+def _request_id(environ, header=None):
+    """ Return the request ID cached in a WSGI environ, creating it on first use.
+        The client's value of ``header`` is used if it is printable ASCII, or
+        else a new random 32-character hex string. """
+    if 'bottle.request.id' not in environ:
+        value = header and WSGIHeaderDict(environ).get(header)
+        if not value or not (value.isascii() and value.isprintable()):
+            value = os.urandom(16).hex()
+        environ['bottle.request.id'] = value
+    return environ['bottle.request.id']
+
