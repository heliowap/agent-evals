@@ -74,6 +75,35 @@ class TestRouter(unittest.TestCase):
         self.assertRaises(bottle.HTTPError, self.match, '/object/')
         self.assertRaises(bottle.HTTPError, self.match, '/object/.')
 
+    def testUUIDFilter(self):
+        u = '01234567-89ab-cdef-0123-456789abcdef'
+        self.assertMatches('/object/<id:uuid>', '/object/' + u, id=uuid.UUID(u))
+        self.assertMatches('/object/<id:uuid>', '/object/' + u.upper(), id=uuid.UUID(u))
+        self.assertRaises(bottle.HTTPError, self.match, '/object/abc')
+        self.assertRaises(bottle.HTTPError, self.match, '/object/' + u.replace('-', ''))
+        self.assertRaises(bottle.HTTPError, self.match, '/object/' + u + 'x')
+        self.assertRaises(bottle.HTTPError, self.match, '/object/' + u.replace('-', 'g', 1))
+
+    def testUUIDFilterNotFound(self):
+        self.add('/object/<id:uuid>', 'handler')
+        try:
+            self.match('/object/not-a-uuid')
+        except bottle.HTTPError as e:
+            self.assertEqual(404, e.status_code)
+        else:
+            self.fail('HTTPError(404) not raised')
+
+    def testUUIDFilterBuild(self):
+        add, build = self.add, self.r.build
+        u = uuid.UUID('01234567-89AB-CDEF-0123-456789ABCDEF')
+        add('/object/<id:uuid>', 'handler', name='uuidroute')
+        add('/anon/<:uuid>', 'handler', name='anonuuidroute')
+
+        self.assertEqual('/object/' + str(u).lower(), build('uuidroute', id=u))
+        self.assertEqual('/object/' + str(u).lower(), build('uuidroute', id=str(u)))
+        self.assertEqual('/anon/' + str(u).lower(), build('anonuuidroute', str(u)))
+        self.assertRaises(ValueError, build, 'uuidroute', id='hello')
+
     def testPathFilter(self):
         self.assertMatches('/<id:path>/:f', '/a/b', id='a', f='b')
         self.assertMatches('/<id:path>', '/a', id='a')
