+def _request_id(environ, header=None):
+    """ Return the request ID stored in a WSGI environ. The first call picks the
+        value: the given request header if the request has it, or else a new
+        random ID. Later calls return the stored value. """
+    key = 'bottle.request.id'
+    if key not in environ:
+        value = WSGIHeaderDict(environ).get(header) if header else None
+        environ[key] = value or secrets.token_hex(16)
+    return environ[key]
+
