diff --git a/bottle/07_http_base_request.py b/bottle/07_http_base_request.py
index bb4f116..2da7013 100644
--- a/bottle/07_http_base_request.py
+++ b/bottle/07_http_base_request.py
@@ -61,6 +61,18 @@ class BaseRequest:
         """ Return the value of a request header, or a given default value. """
         return self.headers.get(name, default)
 
+    @property
+    def request_id(self):
+        """ An ID for this request, or None if ``request_id.header`` is not set
+            in the application config. If the request has that header with a
+            non-empty value, the value is used. Otherwise a random ID with 32
+            lowercase hex characters is generated. The same ID is returned for
+            the whole request and sent back in the configured response header. """
+        app = self.environ.get('bottle.app')
+        name = app.config.get('request_id.header') if app else None
+        if not name: return None
+        return _request_id(self.environ, name)
+
     @DictProperty('environ', 'bottle.request.cookies', read_only=True)
     def cookies(self):
         """ Cookies parsed into a :class:`FormsDict`. Signed cookies are NOT
@@ -467,3 +479,12 @@ def _hval(value):
     if '\n' in value or '\r' in value or '\0' in value:
         raise ValueError("Header value must not contain control characters: %r" % value)
     return value
+
+
+def _request_id(environ, name):
+    """ Return the request ID of a WSGI environ. It is taken from the request
+        header *name* on first use and then cached in the environ. """
+    if 'bottle.request.id' not in environ:
+        value = WSGIHeaderDict(environ).get(name)
+        environ['bottle.request.id'] = value or os.urandom(16).hex()
+    return environ['bottle.request.id']
diff --git a/test/test_request_id.py b/test/test_request_id.py
new file mode 100644
index 0000000..e284447
--- /dev/null
+++ b/test/test_request_id.py
@@ -0,0 +1,120 @@
+# -*- coding: utf-8 -*-
+import re
+import unittest
+
+import bottle
+from bottle import request, response, abort, redirect, HTTPResponse
+from .tools import ServerTestBase
+
+HEX32 = re.compile(r'^[0-9a-f]{32}$')
+
+
+class TestRequestId(ServerTestBase):
+
+    def setUp(self):
+        super().setUp()
+        self.app.config['request_id.header'] = 'X-Request-ID'
+
+    def test_disabled_by_default(self):
+        @bottle.route('/')
+        def test(): return repr(request.request_id)
+        self.app.config['request_id.header'] = None
+        result = self.urlopen('/', env={'HTTP_X_REQUEST_ID': 'abc'})
+        self.assertEqual(result['body'], b'None')
+        self.assertNotIn('X-Request-Id', result['header'])
+
+    def test_echo_incoming_header(self):
+        @bottle.route('/')
+        def test(): return request.request_id
+        result = self.urlopen('/', env={'HTTP_X_REQUEST_ID': 'abc-123'})
+        self.assertEqual(result['body'], b'abc-123')
+        self.assertEqual(result['header']['X-Request-Id'], 'abc-123')
+
+    def test_generated_when_header_missing(self):
+        @bottle.route('/')
+        def test(): return request.request_id
+        first = self.urlopen('/')
+        second = self.urlopen('/')
+        self.assertRegex(first['body'].decode('ascii'), HEX32)
+        self.assertEqual(first['header']['X-Request-Id'], first['body'].decode('ascii'))
+        self.assertNotEqual(first['body'], second['body'])
+
+    def test_generated_when_header_empty(self):
+        @bottle.route('/')
+        def test(): return request.request_id
+        result = self.urlopen('/', env={'HTTP_X_REQUEST_ID': ''})
+        self.assertRegex(result['body'].decode('ascii'), HEX32)
+
+    def test_stable_within_request(self):
+        @bottle.route('/')
+        def test(): return request.request_id + '|' + request.request_id
+        result = self.urlopen('/')
+        first, second = result['body'].decode('ascii').split('|')
+        self.assertRegex(first, HEX32)
+        self.assertEqual(first, second)
+        self.assertEqual(result['header']['X-Request-Id'], first)
+
+    def test_normal_response(self):
+        @bottle.route('/')
+        def test(): return 'ok'
+        self.assertHeader('X-Request-Id', 'rid-1', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+
+    def test_404(self):
+        self.assertStatus(404, '/nope', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+        self.assertHeader('X-Request-Id', 'rid-1', '/nope', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+
+    def test_uncaught_exception(self):
+        @bottle.route('/')
+        def test(): raise RuntimeError('boom')
+        self.assertStatus(500, '/', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+        self.assertHeader('X-Request-Id', 'rid-1', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+
+    def test_abort(self):
+        @bottle.route('/')
+        def test(): abort(403, 'no')
+        self.assertStatus(403, '/', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+        self.assertHeader('X-Request-Id', 'rid-1', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+
+    def test_redirect(self):
+        @bottle.route('/')
+        def test(): redirect('/elsewhere')
+        env = {'HTTP_X_REQUEST_ID': 'rid-1', 'SERVER_PROTOCOL': 'HTTP/1.1'}
+        self.assertStatus(303, '/', env=dict(env))
+        self.assertHeader('X-Request-Id', 'rid-1', env=dict(env))
+
+    def test_raised_httpresponse(self):
+        @bottle.route('/')
+        def test(): raise HTTPResponse('teapot', 418)
+        self.assertStatus(418, '/', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+        self.assertHeader('X-Request-Id', 'rid-1', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+
+    def test_returned_httpresponse_with_own_header(self):
+        @bottle.route('/')
+        def test(): return HTTPResponse('ok', headers={'X-Request-ID': 'other'})
+        self.assertHeader('X-Request-Id', 'rid-1', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+
+    def test_error_handler(self):
+        @self.app.error(404)
+        def handler(res): return 'custom'
+        self.assertStatus(404, '/nope', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+        self.assertHeader('X-Request-Id', 'rid-1', '/nope', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+
+    def test_critical_error(self):
+        # An error handler that raises escapes _handle() and hits the outer
+        # 500 path in wsgi().
+        @self.app.error(404)
+        def handler(res): raise RuntimeError('broken handler')
+        self.assertStatus(500, '/nope', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+        self.assertHeader('X-Request-Id', 'rid-1', '/nope', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+
+    def test_response_header_is_replaced(self):
+        @bottle.route('/')
+        def test():
+            response.set_header('X-Request-ID', 'other')
+            return 'ok'
+        result = self.urlopen('/', env={'HTTP_X_REQUEST_ID': 'rid-1'})
+        self.assertEqual(result['header']['X-Request-Id'], 'rid-1')
+
+
+if __name__ == '__main__':  # pragma: no cover
+    unittest.main()
