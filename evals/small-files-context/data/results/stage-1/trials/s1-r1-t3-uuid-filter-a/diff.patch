         # RouteBuildError: Missing URL argument: anon0.
         self.assertRaises(ValueError, build, 'introute', 'hello')
 
+    def testBuildUUIDFilter(self):
+        add, build = self.add, self.r.build
+        add('/object/<id:uuid>', 'handler', name='uuidroute')
+
+        u = uuid.UUID('12345678-1234-5678-9ABC-DEF012345678')
+        url = build('uuidroute', id=u)
+        self.assertEqual('/object/12345678-1234-5678-9abc-def012345678', url)
+        self.assertEqual(url, build('uuidroute', id=str(u)))
+
+        # Round trip: a built URL matches and yields the original UUID.
+        self.assertEqual(u, self.match(url)[1]['id'])
+
+        self.assertRaises(ValueError, build, 'uuidroute', id='hello')
+
     def test_dynamic_before_static_any(self):
