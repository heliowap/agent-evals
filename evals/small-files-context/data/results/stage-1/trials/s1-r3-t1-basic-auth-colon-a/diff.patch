diff --git a/test/test_auth.py b/test/test_auth.py
index d3592f6..781bb31 100644
--- a/test/test_auth.py
+++ b/test/test_auth.py
@@ -10,3 +10,16 @@ class TestBasicAuth(ServerTestBase):
         def test(): return {}
         self.assertStatus(401)
         self.assertHeader('Www-Authenticate', 'Basic realm="private"')
+
+    def test_colon_in_password(self):
+        @bottle.route('/')
+        @bottle.auth_basic(lambda u, p: u == 'user' and p == 'pa:ss:word')
+        def test(): return 'OK'
+        self.assertBody('OK', env={'HTTP_AUTHORIZATION': 'Basic dXNlcjpwYTpzczp3b3Jk'})
+        self.assertStatus(401, env={'HTTP_AUTHORIZATION': 'Basic dXNlcjp3cm9uZw=='})
+
+    def test_parse_auth(self):
+        self.assertEqual(('user', 'pa:ss:word'), bottle.parse_auth('Basic dXNlcjpwYTpzczp3b3Jk'))
+        self.assertEqual(('user', 'pa:ss'), bottle.parse_auth('Basic dXNlcjpwYTpzcw=='))
+        self.assertEqual(('user', ''), bottle.parse_auth('Basic dXNlcjo='))
+        self.assertIsNone(bottle.parse_auth('Basic dXNlcg=='))
