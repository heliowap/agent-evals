+def _request_id(environ, header):
+    """ Return the request ID of the request in *environ*. The ID is taken from
+        the *header* of the request if present, or generated, and cached in the
+        environ so that every later call returns the same value. """
+    rid = environ.get('bottle.request.id')
+    if rid is None:
+        rid = WSGIHeaderDict(environ).get(header) if header else None
+        rid = rid or os.urandom(16).hex()
+        environ['bottle.request.id'] = rid
+    return rid
+
