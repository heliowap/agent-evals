 # -*- coding: utf-8 -*-
+import base64
+import unittest
 import bottle
 from .tools import ServerTestBase
 
+class TestParseAuth(unittest.TestCase):
+
+    def basic(self, credentials):
+        return 'Basic ' + base64.b64encode(credentials.encode('utf8')).decode('ascii')
+
+    def test__password_without_colon(self):
+        self.assertEqual(('alice', 'secret'), bottle.parse_auth(self.basic('alice:secret')))
+
+    def test__password_with_colon(self):
+        self.assertEqual(('alice', 'pa:ss:word'), bottle.parse_auth(self.basic('alice:pa:ss:word')))
+
+    def test__missing_colon(self):
+        self.assertIsNone(bottle.parse_auth(self.basic('alice')))
+
