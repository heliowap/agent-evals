+def _shape(value):
+    return {dict: 'object', list: 'array', str: 'string', int: 'number', float: 'number', bool: 'boolean', type(None): 'null'}.get(type(value), 'invalid')
+
+
+def _metadata(value, strings=(), booleans=()):
+    result = {'shape': _shape(value)}
+    if isinstance(value, dict):
+        result['keys'] = sorted(set(value) & set((*strings, *booleans)))
+        for key in strings:
+            if key in value:
+                result[key] = value[key] if isinstance(value[key], str) else {'shape': _shape(value[key])}
+        for key in booleans:
+            if key in value:
+                result[key] = value[key] if type(value[key]) is bool else {'shape': _shape(value[key])}
+    return result
+
+
+def _mcp_observation(value, attempt, elapsed):
+    rows = value.get('data') if isinstance(value, dict) else None
+    result = {'attempt': attempt, 'elapsed_s': elapsed, 'envelope_shape': _shape(value),
+              'data_shape': _shape(rows), 'row_count': len(rows) if isinstance(rows, list) else None, 'rows': []}
+    for row in rows if isinstance(rows, list) else []:
+        safe = _metadata(row, ('name',))
+        if isinstance(row, dict):
+            safe['row_keys'] = sorted(set(row) & {'name', 'status', 'integrationID'})
+            safe['extra_key_count'] = len(set(row) - {'name', 'status', 'integrationID'})
+            status = row.get('status')
+            safe['status_shape'] = _shape(status)
+            state = status.get('status') if isinstance(status, dict) else None
+            safe['status_kind'] = state if state in ('pending', 'connected', 'failed', 'disabled', 'needs_auth') else 'invalid'
+            safe['integration_id_present'] = 'integrationID' in row
+        result['rows'].append(safe)
+    return result
+
+
+def _config_observation(entries, root):
+    sources, configurations = [], []
+    for entry in entries if isinstance(entries, list) else []:
+        source = _metadata(entry, ('type',))
+        if not isinstance(entry, dict):
+            sources.append(source)
+            continue
+        path = entry.get('path')
+        if isinstance(path, str):
+            resolved = Path(path).resolve()
+            source['path'] = str(resolved.relative_to(root)) if resolved.is_relative_to(root) else 'outside_private_runtime'
+        sources.append(source)
+        info = entry.get('info')
+        mcp = info.get('mcp') if isinstance(info, dict) else None
+        safe = {'source': len(sources) - 1, 'shape': _shape(mcp), 'servers': []}
+        if isinstance(mcp, dict):
+            safe['layout'] = 'native' if 'servers' in mcp else 'legacy_or_empty'
+            servers = mcp.get('servers', {}) if 'servers' in mcp else {key: value for key, value in mcp.items() if key != 'timeout'}
+            safe['servers_shape'] = _shape(servers)
+            for name, server in servers.items() if isinstance(servers, dict) else []:
+                row = {'name': name, **_metadata(server, ('type',), ('disabled', 'codemode'))}
+                timeout = server.get('timeout') if isinstance(server, dict) else None
+                row['timeout_shape'] = _shape(timeout)
+                row['timeout'] = {key: value for key, value in timeout.items() if key in ('startup', 'catalog', 'execution') and type(value) in (int, float)} if isinstance(timeout, dict) else {}
+                safe['servers'].append(row)
+        configurations.append(safe)
+    return sources, configurations
+
+
+def _surface_observation(root):
+    path = root / 'surface.jsonl'
+    result = []
+    for line in path.read_text().splitlines() if path.exists() else []:
+        try:
+            row = json.loads(line)
+        except ValueError:
+            result.append({'shape': 'invalid_json'})
+            continue
+        tools = row.get('tools') if isinstance(row, dict) else None
+        result.append({'shape': _shape(row), 'tools_shape': _shape(tools), 'tools': [
+            _metadata(tool, ('id', 'name', 'raw_name', 'namespace', 'permission'), ('codemode',))
+            for tool in tools if isinstance(tools, list)] if isinstance(tools, list) else []})
+    return result
+
