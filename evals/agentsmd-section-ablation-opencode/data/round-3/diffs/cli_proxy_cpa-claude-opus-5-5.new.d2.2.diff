+
+
+def median(xs):
+    if not xs:
+        raise ValueError("median of empty sequence")
+    s = sorted(xs)
+    mid = len(s) // 2
+    if len(s) % 2:
+        return s[mid]
+    return (s[mid - 1] + s[mid]) / 2
