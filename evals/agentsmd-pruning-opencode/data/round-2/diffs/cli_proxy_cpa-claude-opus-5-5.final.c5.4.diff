+def median(xs):
+    """Median of xs; mean of the two middle values for even lengths."""
+    s = sorted(xs)
+    if not s:
+        raise ValueError("median() arg is an empty sequence")
+    mid = len(s) // 2
+    if len(s) % 2:
+        return s[mid]
+    return (s[mid - 1] + s[mid]) / 2
