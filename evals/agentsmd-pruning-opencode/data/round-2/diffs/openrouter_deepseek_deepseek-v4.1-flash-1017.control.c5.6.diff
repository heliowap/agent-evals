+def median(xs):
+    """Return the median of xs, averaging the two middles for even lengths."""
+    values = sorted(xs)
+    mid = len(values) // 2
+    if len(values) % 2:
+        return values[mid]
+    return (values[mid - 1] + values[mid]) / 2
