+def median(xs):
+    """Return the median of xs; averages the two middle values when even."""
+    if not xs:
+        raise ValueError("median() arg is an empty sequence")
+    ordered = sorted(xs)
+    mid = len(ordered) // 2
+    if len(ordered) % 2:
+        return ordered[mid]
+    return (ordered[mid - 1] + ordered[mid]) / 2
